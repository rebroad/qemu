#!/usr/bin/python3
"""Save or discard an offline libvirt qcow2 overlay."""

import json
import os
import pwd
import re
import stat
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

QEMU_IMG = "/usr/local/bin/qemu-img"
GUARDED_HELPER = "/usr/local/libexec/qemu-guarded-cow"
PWG_NS = "urn:qemu:partition-write-guard:1"


def run(*args):
    return subprocess.run(args, check=True, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE).stdout


def fail(message):
    raise RuntimeError(message)


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 3 or sys.argv[1] not in ("save", "discard"):
        fail("usage: qemu-cow-manager save|discard DOMAIN")
    action, domain = sys.argv[1:]
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", domain):
        fail("invalid libvirt domain name")
    root = ET.fromstring(run("virsh", "dumpxml", "--inactive", domain))
    if root.findtext("name") != domain:
        fail("libvirt returned an unexpected domain")
    if root.find(f"./metadata/{{{PWG_NS}}}guardedCow") is not None:
        os.execv(GUARDED_HELPER, [GUARDED_HELPER, action, domain])
    if run("virsh", "domstate", domain).strip().lower() != "shut off":
        fail("VM must be fully shut off before save/discard")
    info = run("virsh", "dominfo", domain)
    if not re.search(r"^Managed save:\s+no\s*$", info, re.MULTILINE):
        fail("VM has a managed-save state; clear it before save/discard")
    disks = [disk for disk in root.findall("./devices/disk") if disk.get("device") == "disk"]
    if len(disks) != 1:
        fail("COW save/discard requires exactly one system disk")
    disk = disks[0]
    driver = disk.find("driver")
    source = disk.find("source")
    backing = disk.find("backingStore")
    fmt = backing.find("format") if backing is not None else None
    base = backing.find("source") if backing is not None else None
    if (disk.get("type") != "file" or driver is None or driver.get("type") != "qcow2"
            or source is None or not source.get("file") or backing is None
            or fmt is None or not fmt.get("type") or base is None):
        fail("expected one qcow2 overlay with a configured backing image")
    is_block = backing.get("type") == "block"
    backing_file = base.get("dev") if is_block else base.get("file")
    backing_fmt = fmt.get("type")
    if not backing_file or (is_block and backing_fmt != "raw"):
        fail("unsupported backing image source or format")
    overlay = source.get("file")
    qinfo = json.loads(run(QEMU_IMG, "info", "--output=json", overlay))
    st = os.lstat(overlay)
    owner = pwd.getpwnam("libvirt-qemu")
    base_size = int(run("blockdev", "--getsize64", backing_file)) if is_block else os.stat(backing_file).st_size
    if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_uid != owner.pw_uid
            or qinfo.get("format") != "qcow2" or qinfo.get("backing-filename") != backing_file
            or qinfo.get("backing-filename-format") != backing_fmt
            or qinfo.get("virtual-size") != base_size
            or qinfo.get("format-specific", {}).get("data", {}).get("corrupt")):
        fail("overlay ownership, format, backing image, or health is not approved")
    if action == "save":
        if is_block:
            tree = json.loads(run("lsblk", "--json", "--paths", "--output", "NAME,TYPE,MOUNTPOINTS", backing_file))
            nodes = []
            def collect(items):
                for item in items:
                    nodes.append(item)
                    collect(item.get("children", []))
            collect(tree.get("blockdevices", []))
            if any(point for node in nodes for point in (node.get("mountpoints") or [])):
                fail("cannot save an unguarded raw-disk overlay while any disk partition is mounted")
            swaps = run("swapon", "--show", "--noheadings", "--raw", "--output", "NAME").splitlines()
            disk_nodes = {os.path.realpath(node["name"]) for node in nodes}
            for swap in swaps:
                try:
                    if os.path.realpath(swap) in disk_nodes:
                        fail(f"cannot save while disk partition is active swap: {swap}")
                except OSError:
                    fail(f"cannot validate active swap device {swap}")
        run(QEMU_IMG, "commit", overlay)
    directory = os.path.dirname(overlay)
    fd, new_overlay = tempfile.mkstemp(prefix=".qemu-cow-", suffix=".qcow2", dir=directory)
    os.close(fd)
    os.unlink(new_overlay)
    try:
        run(QEMU_IMG, "create", "-q", "-f", "qcow2", "-F", backing_fmt,
            "-b", backing_file, new_overlay)
        os.chown(new_overlay, owner.pw_uid, owner.pw_gid)
        os.chmod(new_overlay, 0o600)
        os.replace(new_overlay, overlay)
    finally:
        try:
            os.unlink(new_overlay)
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"qemu-cow-manager: {error}", file=sys.stderr)
        sys.exit(1)
