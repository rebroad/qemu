#!/usr/bin/python3
"""Report GPT partitions whose current contents come from a guarded qcow2 COW."""

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys


def load_guard_helper():
    path = Path(__file__).with_name("qemu-guarded-cow")
    loader = importlib.machinery.SourceFileLoader("qemu_guarded_cow", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def command(*args):
    result = subprocess.run(args, check=False, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(detail or f"command failed with status {result.returncode}: {args[0]}")
    return result.stdout


def ensure_overlay_closed(path):
    result = subprocess.run(["fuser", "-s", path], check=False)
    if result.returncode == 0:
        raise RuntimeError(f"overlay is open by another process: {path}")
    if result.returncode != 1:
        raise RuntimeError(f"could not determine whether the overlay is in use: {path}")


def map_options(helper, config):
    # Every node is opened read-only. Keep the configured partition guard in
    # the graph even though qemu-img map itself does not issue writes.
    options = helper.overlay_options(config).split(",")
    options.extend(("file.read-only=on", "read-only=on"))
    guard = helper.guard_options(config).split(",")
    guard[1] = "file.driver=host_device"
    options.extend("backing." + option for option in guard)
    options.extend(("backing.file.read-only=on", "backing.read-only=on"))
    return ",".join(options)


def map_allocations(helper, config, inventory):
    info = json.loads(command(helper.QEMU_IMG, "info", "--output=json",
                              config["overlay"]))
    if (info.get("format") != "qcow2"
            or info.get("backing-filename") != config["disk"]
            or info.get("backing-filename-format") != "raw"
            or info.get("virtual-size") != inventory["size_bytes"]):
        raise RuntimeError("overlay format, backing device, or virtual size does not match the VM configuration")

    output = command(helper.QEMU_IMG, "map", "--output=json", "--image-opts",
                     map_options(helper, config))
    rows = json.loads(output)
    ranges = []
    disk_size = inventory["size_bytes"]
    for row in rows:
        start = int(row["start"])
        length = int(row["length"])
        end = start + length
        if start < 0 or length <= 0 or end > disk_size:
            raise RuntimeError("qemu-img map returned an invalid range")
        # map depth zero means this range is currently resolved by the qcow2
        # overlay. This includes explicit zero clusters, not just nonzero data.
        if int(row["depth"]) == 0:
            ranges.append((start, end))
    ranges.sort()
    for previous, current in zip(ranges, ranges[1:]):
        if current[0] < previous[1]:
            raise RuntimeError("qemu-img map returned overlapping overlay ranges")
    return ranges


def partition_totals(partitions, ranges):
    result = {part["number"]: {"bytes": 0, "ranges": 0} for part in partitions}
    outside_partition_bytes = 0
    total_overlay_bytes = 0
    for start, end in ranges:
        total_overlay_bytes += end - start
        covered = 0
        for part in partitions:
            p_start = part["start_bytes"]
            p_end = p_start + part["size_bytes"]
            overlap = max(0, min(end, p_end) - max(start, p_start))
            if overlap:
                result[part["number"]]["bytes"] += overlap
                result[part["number"]]["ranges"] += 1
                covered += overlap
        outside_partition_bytes += end - start - covered
    return result, total_overlay_bytes, outside_partition_bytes


def print_partition_ranges(part, ranges, sector_size):
    p_start = part["start_bytes"]
    p_end = p_start + part["size_bytes"]
    print(f"\np{part['number']} current overlay-sourced ranges (inclusive LBAs):")
    print("Disk LBA range                 Partition-relative LBA range   Bytes")
    found = False
    for start, end in ranges:
        left, right = max(start, p_start), min(end, p_end)
        if left >= right:
            continue
        if left % sector_size or right % sector_size:
            raise RuntimeError("overlay range is not aligned to the disk's logical sectors")
        found = True
        disk_first, disk_last = left // sector_size, right // sector_size - 1
        part_first = (left - p_start) // sector_size
        part_last = (right - p_start) // sector_size - 1
        print(f"{disk_first}..{disk_last:<21} {part_first}..{part_last:<25} {right-left:,}")
    if not found:
        print("(none)")


def main():
    parser = argparse.ArgumentParser(
        description="Show which GPT partitions currently have data supplied by a VM's guarded qcow2 overlay."
    )
    parser.add_argument("domain", help="libvirt domain name")
    parser.add_argument("--qemu-img", default=None,
                        help="custom qemu-img executable (default: the guarded-COW helper's configured binary)")
    parser.add_argument("--ranges", type=int, metavar="PARTITION",
                        help="print exact overlay-sourced sector ranges for this GPT partition")
    args = parser.parse_args()

    if os.geteuid() != 0:
        parser.error("run as root, for example: sudo scripts/qemu-cow-written-partitions win11-phys")

    helper = load_guard_helper()
    if args.qemu_img:
        helper.QEMU_IMG = args.qemu_img

    with helper.operation_lock():
        helper.assert_vm_off(args.domain)
        config = helper.parse_config(args.domain)
        ensure_overlay_closed(config["overlay"])
        inventory = helper.disk_inventory(config)
        print(f"Domain: {args.domain} (shut off)")
        print(f"Disk: {config['disk']} ({inventory['size_bytes']:,} bytes; GPT {inventory['identity']['ptuuid']})")
        print(f"Overlay: {config['overlay']}")
        allowed = ", ".join(str(p["number"]) for p in config["partitions"])
        print(f"Partitions allowed by VM guard: {allowed}")
        print("Mapping overlay allocations read-only...", file=sys.stderr)
        ranges = map_allocations(helper, config, inventory)

    totals, overlay_bytes, outside_bytes = partition_totals(
        inventory["partitions"], ranges)
    if args.ranges is not None:
        selected = next((part for part in inventory["partitions"]
                         if part["number"] == args.ranges), None)
        if selected is None:
            raise RuntimeError(f"GPT partition {args.ranges} does not exist")
        print_partition_ranges(selected, ranges, inventory["sector_size"])
    allowed_numbers = {part["number"] for part in config["partitions"]}
    print("\nPartition  Guard  Overlay bytes  Ranges  GPT partition name")
    print("---------  -----  -------------  ------  ------------------")
    unexpected = False
    for part in inventory["partitions"]:
        number = part["number"]
        amount = totals[number]["bytes"]
        guard = "write" if number in allowed_numbers else "no"
        label = part.get("name") or "—"
        print(f"{number:>9}  {guard:>5}  {amount:>13,}  {totals[number]['ranges']:>6}  {label}")
        if amount and number not in allowed_numbers:
            unexpected = True

    print(f"\nOverlay-provided bytes across disk: {overlay_bytes:,}")
    print(f"Overlay-provided bytes outside GPT partitions: {outside_bytes:,}")
    if outside_bytes:
        unexpected = True
    if unexpected:
        print("WARNING: overlay data was found outside the VM's configured writable partitions.",
              file=sys.stderr)
        return 2
    print("Note: this reports current overlay allocations, not a historical write log.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"qemu-cow-written-partitions: {exc}", file=sys.stderr)
        sys.exit(1)
