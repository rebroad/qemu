#!/usr/bin/python3
"""Report exact partition-sector targets from a guarded COW commit dry-run."""

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import pwd
import stat
import subprocess
import sys


def load_guard_helper():
    path = Path(__file__).with_name("qemu-guarded-cow")
    loader = importlib.machinery.SourceFileLoader("qemu_guarded_cow", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def ensure_overlay_closed(path):
    result = subprocess.run(["fuser", "-s", path], check=False)
    if result.returncode == 0:
        raise RuntimeError(f"overlay is open by another process: {path}")
    if result.returncode != 1:
        raise RuntimeError(f"could not determine whether the overlay is in use: {path}")


def check_overlay(helper, config, inventory):
    info = json.loads(helper.run(
        helper.QEMU_IMG, "info", "--output=json", config["overlay"]).stdout)
    helper.run(helper.QEMU_IMG, "check", "-q", config["overlay"])
    if (info.get("format") != "qcow2"
            or info.get("backing-filename") != config["disk"]
            or info.get("backing-filename-format") != "raw"
            or info.get("virtual-size") != inventory["size_bytes"]):
        raise RuntimeError("overlay format, backing device, or virtual size does not match the VM configuration")
    st = os.stat(config["overlay"])
    expected_uid = pwd.getpwnam(helper.HELPER_USER).pw_uid
    permissions_ok = (st.st_uid == expected_uid
                      and stat.S_IMODE(st.st_mode) == 0o600)
    return st, expected_uid, permissions_ok


def partition_write_plan(extents, inventory, allowed_numbers):
    sector_size = inventory["sector_size"]
    partitions = inventory["partitions"]
    by_partition = {}
    operations = {}
    for extent in extents:
        start = extent["offset"]
        end = start + extent["length"]
        part = next((candidate for candidate in partitions
                     if start >= candidate["start_bytes"]
                     and end <= candidate["start_bytes"] + candidate["size_bytes"]),
                    None)
        if part is None:
            raise RuntimeError("dry-run includes a write outside all GPT partitions")
        number = part["number"]
        if number not in allowed_numbers:
            raise RuntimeError(f"dry-run includes a write to off-limits GPT partition {number}")
        if start % sector_size or end % sector_size:
            raise RuntimeError("dry-run returned a write not aligned to logical sectors")
        first_disk = start // sector_size
        last_disk_exclusive = end // sector_size
        first_partition = first_disk - part["start_bytes"] // sector_size
        last_partition_exclusive = last_disk_exclusive - part["start_bytes"] // sector_size
        operation = extent["operation"]
        by_partition.setdefault(number, []).append(
            (first_partition, last_partition_exclusive,
             first_disk, last_disk_exclusive, operation))
        counts = operations.setdefault(number, {})
        counts[operation] = counts.get(operation, 0) + 1

    grouped = {}
    for number, rows in by_partition.items():
        rows.sort()
        merged = []
        for row in rows:
            if (merged and merged[-1][1] == row[0]
                    and merged[-1][4] == row[4]):
                previous = merged[-1]
                merged[-1] = (previous[0], row[1], previous[2], row[3], row[4])
            else:
                merged.append(row)
        grouped[number] = merged
    return grouped, operations


def format_lba(first, end_exclusive):
    return f"{first:,}–{end_exclusive - 1:,}"


def main():
    parser = argparse.ArgumentParser(
        description="Show exact GPT sector ranges targeted by the guarded COW commit dry-run.")
    parser.add_argument("domain", help="libvirt domain name")
    parser.add_argument("--qemu-img", default=None,
                        help="custom qemu-img executable (default: helper-configured binary)")
    parser.add_argument("--partition", type=int, metavar="NUMBER",
                        help="show ranges for one GPT partition; default: all affected partitions")
    parser.add_argument("--summary-only", action="store_true",
                        help="omit the detailed sector-range lists")
    args = parser.parse_args()

    if os.geteuid() != 0:
        parser.error("run as root, for example: sudo scripts/qemu-cow-written-partitions win11-phys")

    helper = load_guard_helper()
    if args.qemu_img:
        helper.QEMU_IMG = args.qemu_img

    with helper.operation_lock():
        helper.assert_vm_off(args.domain)
        config = helper.parse_config(args.domain)
        ensure_overlay_closed(config["overlay"])
        inventory = helper.disk_inventory(config)
        overlay_stat, expected_uid, permissions_ok = check_overlay(
            helper, config, inventory)
        print("Running guarded QEMU commit dry-run; physical backing writes are disabled...",
              file=sys.stderr)
        _raw_plan, extents, planned_inventory = helper.make_write_plan(config)
        if planned_inventory != inventory:
            raise RuntimeError("disk identity or GPT layout changed during dry-run")

    allowed_numbers = {part["number"] for part in config["partitions"]}
    grouped, operations = partition_write_plan(
        extents, inventory, allowed_numbers)
    if args.partition is not None and args.partition not in {
            part["number"] for part in inventory["partitions"]}:
        raise RuntimeError(f"GPT partition {args.partition} does not exist")

    print(f"Domain: {args.domain} (shut off)")
    print(f"Disk: {config['disk']} ({inventory['size_bytes']:,} bytes; GPT {inventory['identity']['ptuuid']})")
    print(f"Overlay: {config['overlay']}")
    print(f"Overlay permissions: uid={overlay_stat.st_uid}, mode={stat.S_IMODE(overlay_stat.st_mode):04o}; "
          f"review requires uid={expected_uid}, mode=0600 — "
          f"{'pass' if permissions_ok else 'FAIL'}")
    print("Dry-run only: no physical-disk writes were issued.")
    print("These are commit targets for the current overlay, not a historical guest-write log.")
    print(f"Planned QEMU write extents: {len(extents):,}")

    selected_numbers = ([args.partition] if args.partition is not None
                        else sorted(grouped))
    print("\nAffected partitions:")
    print("Partition  Planned sectors  Raw extents  GPT partition name")
    print("---------  ---------------  -----------  ------------------")
    for part in inventory["partitions"]:
        number = part["number"]
        if number not in selected_numbers:
            continue
        sectors = sum(end - start for start, end, *_ in grouped.get(number, []))
        raw_count = sum(operations.get(number, {}).values())
        label = part.get("name") or "—"
        print(f"{number:>9}  {sectors:>15,}  {raw_count:>11,}  {label}")

    if not args.summary_only:
        for part in inventory["partitions"]:
            number = part["number"]
            if number not in grouped or number not in selected_numbers:
                continue
            print(f"\np{number} planned commit ranges (inclusive LBAs; {inventory['sector_size']}-byte sectors):")
            print("Partition-relative sectors   Physical-disk LBAs          Operation")
            for first, end, disk_first, disk_end, operation in grouped[number]:
                print(f"{format_lba(first, end):<28} {format_lba(disk_first, disk_end):<27} {operation}")

    print("\nA range is included in the plan only when QEMU's commit traversal sends it to the guarded backing node.")
    print("This report is not save approval; use the guarded review flow before any physical commit.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"qemu-cow-written-partitions: {exc}", file=sys.stderr)
        sys.exit(1)
