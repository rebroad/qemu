#!/usr/bin/python3
"""Guard a libvirt qcow2 overlay backed by a partitioned physical disk."""

import json
import hashlib
import fcntl
import os
import pwd
import re
import secrets
import stat
import struct
import subprocess
import sys
import tempfile
import time
import uuid
import zlib
from contextlib import contextmanager
import xml.etree.ElementTree as ET
from pathlib import Path

QEMU_IMG = "/usr/local/bin/qemu-img"
HELPER_USER = "libvirt-qemu"
RUN_DIR = Path("/run/libvirt/qemu-guarded-cow")
STATE = RUN_DIR / "active.json"
REVIEW_DIR = RUN_DIR / "reviews"
LOCK_FILE = RUN_DIR / "operation.lock"
JOURNAL_DIR = Path("/var/lib/libvirt/qemu-guarded-cow")
INSTALLED_HELPER = Path("/usr/local/libexec/qemu-guarded-cow")
HELPER_SOURCE_MANIFEST = Path("/usr/local/libexec/qemu-guarded-cow.source.json")
RECOVERY_SERVICE = "qemu-guarded-cow-recovery-check.service"
RECOVERY_SERVICE_PATH = Path("/etc/systemd/system") / RECOVERY_SERVICE
REVIEW_TTL = 3600
# Disposable-disk success, partial interruption, retry, and reboot-state
# recovery validation passed with the installed helper and qemu-img. Each real
# save still requires a fresh review and explicit confirmation.
PHYSICAL_COMMIT_ENABLED = True
# Libvirt's hook PATH places /usr/local/sbin first, where this host has
# command copies that libvirtd's AppArmor profile intentionally cannot run.
os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
QEMU_NS = "http://libvirt.org/schemas/domain/qemu/1.0"
PWG_NS = "urn:qemu:partition-write-guard:1"
EFI_SYSTEM_PARTITION_GUID = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"


class GuardError(RuntimeError):
    pass


def run(*args, input=None):
    return subprocess.run(args, input=input, check=True, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def fail(message):
    raise GuardError(message)


def helper_identity(require_source=True):
    helper_path = Path(__file__).resolve()
    try:
        helper_digest = hashlib.sha256(helper_path.read_bytes()).hexdigest()
    except OSError as exc:
        fail(f"cannot fingerprint the guarded COW helper: {exc}")
    installed = helper_path == INSTALLED_HELPER.resolve()
    identity = {"path": str(helper_path), "sha256": helper_digest,
                "installed": installed, "source_match": None,
                "source_path": None}
    if not installed:
        return identity
    try:
        st = os.lstat(HELPER_SOURCE_MANIFEST)
        if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1
                or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o644):
            fail("guarded COW helper source manifest has unsafe ownership or mode")
        manifest = json.loads(HELPER_SOURCE_MANIFEST.read_text(encoding="utf-8"))
        source_path = Path(manifest["source"])
        if not source_path.is_absolute():
            fail("guarded COW helper source manifest path is not absolute")
        source_digest = (hashlib.sha256(source_path.read_bytes()).hexdigest()
                         if require_source else None)
    except GuardError:
        raise
    except Exception as exc:
        fail(f"cannot verify guarded COW helper against its installed source manifest: {exc}")
    if (manifest.get("schema") != "qemu-guarded-cow-source-v1"
            or manifest.get("sha256") != helper_digest
            or (require_source and source_digest != helper_digest)):
        fail("installed guarded COW helper does not match its recorded source")
    identity.update(source_match=(True if require_source else None),
                    source_path=str(source_path),
                    manifest_sha256=hashlib.sha256(
                        HELPER_SOURCE_MANIFEST.read_bytes()).hexdigest())
    return identity


def recovery_guard_identity(require_active=True):
    if Path(__file__).resolve() != INSTALLED_HELPER.resolve():
        return None
    try:
        st = os.lstat(RECOVERY_SERVICE_PATH)
        content = RECOVERY_SERVICE_PATH.read_bytes()
        properties = run(
            "systemctl", "show", RECOVERY_SERVICE,
            "-p", "LoadState", "-p", "ActiveState", "-p", "UnitFileState",
            "-p", "FragmentPath", "-p", "DropInPaths", "-p", "ExecStart",
            "-p", "Before", "-p", "After", "-p", "OnFailure",
            "-p", "OnFailureJobMode", "-p", "DefaultDependencies",
            "-p", "RequiresMountsFor").stdout
    except Exception as exc:
        fail(f"cannot verify the early-boot guarded COW recovery service: {exc}")
    effective = dict(line.split("=", 1) for line in properties.splitlines()
                     if "=" in line)
    required = (b"DefaultDependencies=no", b"After=systemd-remount-fs.service",
                b"Before=local-fs-pre.target", b"RequiresMountsFor=/var/lib/libvirt/qemu-guarded-cow",
                b"OnFailure=emergency.target", b"OnFailureJobMode=isolate",
                b"Type=oneshot", b"ExecStart=/usr/local/libexec/qemu-guarded-cow boot-check",
                b"RemainAfterExit=yes")
    expected_exec = "/usr/local/libexec/qemu-guarded-cow boot-check"
    if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_uid != 0
            or stat.S_IMODE(st.st_mode) != 0o644
            or any(line.startswith((b"Condition", b"Assert"))
                   for line in content.splitlines())
            or any(line not in content.splitlines() for line in required)
            or effective.get("LoadState") != "loaded"
            or (effective.get("ActiveState") != "active"
                and not (not require_active
                         and effective.get("ActiveState") == "failed"))
            or effective.get("UnitFileState") != "enabled"
            or effective.get("FragmentPath") != str(RECOVERY_SERVICE_PATH)
            or effective.get("DropInPaths", "")
            or effective.get("DefaultDependencies") != "no"
            or "local-fs-pre.target" not in effective.get("Before", "").split()
            or "systemd-remount-fs.service" not in effective.get("After", "").split()
            or "emergency.target" not in effective.get("OnFailure", "").split()
            or effective.get("OnFailureJobMode") != "isolate"
            or "/var/lib/libvirt/qemu-guarded-cow" not in
                effective.get("RequiresMountsFor", "").split()
            or expected_exec not in effective.get("ExecStart", "")):
        fail("early-boot recovery service is not installed, enabled, and fail-closed")
    stable_properties = {
        key: effective[key] for key in (
            "LoadState", "UnitFileState", "FragmentPath", "DropInPaths",
            "Before", "After", "OnFailure", "OnFailureJobMode",
            "DefaultDependencies", "RequiresMountsFor")
    }
    stable_properties["ExecStart"] = expected_exec
    return {"path": str(RECOVERY_SERVICE_PATH),
            "sha256": hashlib.sha256(content).hexdigest(),
            "enabled": True, "active": effective.get("ActiveState") == "active",
            "failure_target": "emergency.target",
            "effective_properties": stable_properties}


@contextmanager
def operation_lock():
    RUN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(RUN_DIR, 0o700)
    fd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC |
                 getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def domain_xml(domain):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", domain):
        fail("invalid libvirt domain name")
    try:
        return run("virsh", "dumpxml", "--inactive", domain).stdout
    except (subprocess.CalledProcessError, OSError) as exc:
        config_path = Path("/etc/libvirt/qemu") / f"{domain}.xml"
        try:
            return config_path.read_text(encoding="utf-8")
        except OSError:
            fail(f"libvirt is unavailable and the inactive domain XML cannot be read: {exc}")


def parse_config(domain, xml_data=None):
    try:
        root = ET.fromstring(xml_data if xml_data is not None else domain_xml(domain))
    except Exception as exc:
        fail(f"cannot read domain XML: {exc}")
    if root.findtext("name") != domain:
        fail("libvirt returned an unexpected domain")
    metadata = root.find(f"./metadata/{{{PWG_NS}}}guardedCow")
    if metadata is None:
        fail("domain has no guarded COW configuration metadata")

    partitions = []
    seen_numbers = set()
    seen_uuids = set()
    for node in metadata.findall(f"{{{PWG_NS}}}partition"):
        try:
            number = int(node.get("number", ""), 10)
        except ValueError:
            fail("configured partition numbers must be decimal integers")
        partuuid = (node.get("partuuid") or "").lower()
        parttype = (node.get("type") or "").lower()
        if (number < 1 or number > 4096 or number in seen_numbers
                or not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", partuuid)
                or not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", parttype)
                or partuuid in seen_uuids):
            fail(f"invalid or duplicate partition configuration for GPT partition {number}")
        seen_numbers.add(number)
        seen_uuids.add(partuuid)
        partitions.append({"number": number, "partuuid": partuuid,
                           "type": parttype, "mountpoint": node.get("mountpoint")})
    if not partitions:
        fail("guarded COW configuration contains no writable GPT partitions")
    partitions.sort(key=lambda part: part["number"])

    disks = [d for d in root.findall("./devices/disk") if d.get("device") == "disk"]
    if len(disks) != 1:
        fail("guarded COW domain must declare exactly one system disk")
    disk = disks[0]
    driver = disk.find("driver")
    source = disk.find("source")
    backing = disk.find("backingStore")
    backing_format = backing.find("format") if backing is not None else None
    backing_source = backing.find("source") if backing is not None else None
    alias = disk.find("alias")
    if (disk.get("type") != "file" or driver is None or driver.get("type") != "qcow2"
            or source is None or not source.get("file")
            or backing is None or backing.get("type") != "block"
            or backing_format is None or backing_format.get("type") != "raw"
            or backing_source is None or not backing_source.get("dev")
            or alias is None or not alias.get("name") or disk.find("readonly") is not None):
        fail("system disk must be a writable qcow2 overlay over one raw block device")
    overlay = source.get("file")
    disk_path = backing_source.get("dev")
    if any(ch in overlay + disk_path for ch in (",", "\\", "=")):
        fail("disk and overlay paths may not contain comma, backslash, or equals characters")

    cmdline = root.find(f"{{{QEMU_NS}}}commandline")
    args = [node.get("value", "") for node in cmdline.findall(f"{{{QEMU_NS}}}arg")] if cmdline is not None else []
    if len(args) != 2 or args[0] != "-blockdev":
        fail("QEMU command line must contain one explicit guarded block node")
    try:
        guard = json.loads(args[1])
    except Exception as exc:
        fail(f"invalid QEMU block node JSON: {exc}")
    configured_numbers = [part["number"] for part in partitions]
    node_name = guard.get("node-name", "")
    if (guard.get("driver") != "partition-write-guard"
            or guard.get("partitions") != configured_numbers
            or not re.fullmatch(r"libvirt-[0-9]+-format", guard.get("file", ""))
            or not re.fullmatch(r"[A-Za-z0-9_.-]+", node_name)):
        fail("QEMU's guard node must wrap the qcow2 format node and match the VM partition allowlist")
    overrides = root.findall(f"{{{QEMU_NS}}}override/{{{QEMU_NS}}}device")
    if len(overrides) != 1 or overrides[0].get("alias") != alias.get("name"):
        fail("QEMU override must select the declared system disk")
    frontend = overrides[0].find(f"{{{QEMU_NS}}}frontend")
    props = frontend.findall(f"{{{QEMU_NS}}}property") if frontend is not None else []
    if (len(props) != 1 or props[0].get("name") != "drive"
            or props[0].get("type") != "string" or props[0].get("value") != node_name):
        fail("the system disk frontend must connect through the configured partition guard")

    return {"domain": domain, "disk": disk_path, "overlay": overlay,
            "partitions": partitions, "guard": guard}


def part_devices(config):
    devices = {}
    disk_real = os.path.realpath(config["disk"])
    for part in config["partitions"]:
        link = f"/dev/disk/by-partuuid/{part['partuuid']}"
        if not os.path.exists(link):
            fail(f"missing configured GPT partition {part['number']} ({part['partuuid']})")
        path = os.path.realpath(link)
        if os.path.dirname(path) != os.path.dirname(disk_real) or not path.startswith(disk_real + "p"):
            fail(f"configured partition {part['number']} is not on {config['disk']}: {path}")
        number = run("lsblk", "-dnro", "PARTN", path).stdout.strip()
        parttype = run("lsblk", "-dnro", "PARTTYPE", path).stdout.strip().lower()
        if number != str(part["number"]) or parttype != part["type"]:
            fail(f"partition {part['number']} identity or GPT type changed")
        dev = os.stat(path).st_rdev
        devices[part["number"]] = {"path": path, "mm": f"{os.major(dev)}:{os.minor(dev)}"}
    return devices


def mount_table():
    rows = []
    with open("/proc/self/mountinfo", encoding="utf-8") as stream:
        for line in stream:
            fields = line.rstrip("\n").split()
            sep = fields.index("-")
            unescape = lambda value: value.replace("\\040", " ").replace("\\011", "\t").replace("\\012", "\n").replace("\\134", "\\")
            rows.append({"mm": fields[2], "target": unescape(fields[4]),
                         "opts": set(fields[5].split(",")),
                         "super": set(fields[sep + 3].split(","))})
    return rows


def mounts_for(devices, number):
    mm = devices[number]["mm"]
    return [row for row in mount_table() if row["mm"] == mm]


def verify_partitions_not_writable(devices, partitions):
    for part in partitions:
        rows = mounts_for(devices, part["number"])
        if any(not is_ro(row) for row in rows):
            fail(f"partition {part['number']} became writable while guarded COW isolation was active")


def verify_no_allowed_swap(devices):
    try:
        swaps = run("swapon", "--show=NAME", "--noheadings",
                    "--raw").stdout.splitlines()
    except Exception as exc:
        fail(f"cannot inspect active swap devices: {exc}")
    allowed = {device["mm"] for device in devices.values()}
    for name in swaps:
        try:
            st = os.stat(os.path.realpath(name))
            if stat.S_ISBLK(st.st_mode):
                mm = f"{os.major(st.st_rdev)}:{os.minor(st.st_rdev)}"
            elif stat.S_ISREG(st.st_mode):
                mm = run("findmnt", "--noheadings", "--output", "MAJ:MIN",
                         "--target", name).stdout.strip()
                if not re.fullmatch(r"[0-9]+:[0-9]+", mm):
                    fail(f"cannot identify the backing partition for swap file {name}")
            else:
                fail(f"cannot determine the backing partition for active swap {name}")
        except GuardError:
            raise
        except Exception as exc:
            fail(f"cannot validate active swap {name}: {exc}")
        if mm in allowed:
            fail(f"configured writable partition is active swap: {name}")


def verify_no_block_device_users(config, devices):
    """Fail closed if a process already has the target disk/partitions open."""
    try:
        targets = {os.stat(config["disk"]).st_rdev}
        targets.update(os.stat(device["path"]).st_rdev
                       for device in devices.values())
    except OSError as exc:
        fail(f"cannot identify guarded block devices before commit: {exc}")
    users = {}
    for proc in Path("/proc").iterdir():
        if not proc.name.isdecimal() or int(proc.name) == os.getpid():
            continue
        try:
            fds = (proc / "fd").iterdir()
            for fd in fds:
                try:
                    st = os.stat(fd)
                except (FileNotFoundError, PermissionError, ProcessLookupError):
                    continue
                if stat.S_ISBLK(st.st_mode) and st.st_rdev in targets:
                    comm = (proc / "comm").read_text(encoding="utf-8").strip()
                    users.setdefault(proc.name, comm)
                    break
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    if users:
        details = ", ".join(f"{pid} ({name})" for pid, name in sorted(users.items()))
        fail("processes already hold the guarded disk or a configured partition open: "
             + details)


def is_rw(row):
    return "rw" in row["opts"] and "rw" in row["super"]


def is_ro(row):
    return "ro" in row["opts"] or "ro" in row["super"]


def remount_readonly(row):
    run("mount", "-o", "remount,ro", "--", row["target"])
    current = [m for m in mount_table() if m["target"] == row["target"] and m["mm"] == row["mm"]]
    if not current or any(not is_ro(m) for m in current):
        fail(f"could not confirm read-only mount at {row['target']}")


def disk_acl(disk):
    return run("getfacl", "-cpn", disk).stdout


def restore_disk_acl(disk, saved):
    run("setfacl", "--set-file=-", disk, input=saved)


def verify_qemu_readonly(disk):
    user = pwd.getpwnam(HELPER_USER).pw_name
    run("runuser", "-u", user, "--", "/usr/bin/test", "-r", disk)
    result = subprocess.run(["runuser", "-u", user, "--", "/usr/bin/test", "-w", disk])
    if result.returncode == 0:
        fail("libvirt-qemu unexpectedly has write permission on the raw backing device")


def parse_firmware_boot(output, efi_partuuids):
    boot_order_match = re.search(r"^BootOrder:\s*(.*)$", output, re.MULTILINE)
    if not boot_order_match:
        fail("cannot read UEFI BootOrder; physical commit is blocked")
    boot_order = [item.upper() for item in boot_order_match.group(1).split(",")
                  if re.fullmatch(r"[0-9A-Fa-f]{4}", item)]
    entries = {}
    for line in output.splitlines():
        match = re.match(r"^Boot([0-9A-Fa-f]{4})(\*)?\s+(.+)$", line)
        if match:
            entries[match.group(1).upper()] = {
                "active": bool(match.group(2)), "details": match.group(3),
            }
    windows = []
    linux = []
    efi_guids = {value.lower() for value in efi_partuuids}
    for ident, entry in entries.items():
        value = entry["details"]
        lower = value.lower()
        part_match = re.search(r"HD\(\d+,GPT,([0-9a-f-]{36})", value,
                               re.IGNORECASE)
        partuuid = part_match.group(1).lower() if part_match else None
        is_windows = ("\\efi\\microsoft\\boot\\bootmgfw.efi" in lower
                      or "windows boot manager" in lower)
        if is_windows and partuuid in efi_guids:
            windows.append({"id": ident, "active": entry["active"]})
        elif (partuuid in efi_guids and "\\efi\\" in lower and entry["active"]
              and not is_windows
              and re.search(r"\\(?:shimx64|grubx64|systemd-bootx64)\.efi", lower)):
            linux.append(ident)
    if not linux:
        fail("cannot identify an active Linux EFI boot entry; physical commit is blocked")
    linux_entry = next((ident for ident in boot_order if ident in linux), linux[0])
    return {"boot_order": boot_order, "linux_entry": linux_entry,
            "windows_entries": sorted(windows, key=lambda item: item["id"]),
            "efi_partuuids": sorted(efi_guids)}


def firmware_boot_snapshot(config, inventory):
    if not stat.S_ISBLK(os.stat(config["disk"]).st_mode):
        return None
    if not Path("/sys/firmware/efi/efivars").is_dir():
        fail("physical commit requires UEFI boot protection; EFI variables are unavailable")
    efi_partuuids = [part["partuuid"] for part in inventory["partitions"]
                     if part["type"].lower() == EFI_SYSTEM_PARTITION_GUID]
    if not efi_partuuids:
        fail("physical disk has no identified EFI System Partition; cannot guard native boot")
    return parse_firmware_boot(
        run("efibootmgr", "-v").stdout, efi_partuuids)


def apply_firmware_boot_guard(snapshot):
    if not snapshot:
        return
    # Make the currently installed Linux loader the only automatic boot target
    # before deactivating Windows entries. The durable transaction already
    # exists at this point; the boot-check service will hold Linux mounts until
    # recovery completes after a crash.
    run("efibootmgr", "-o", snapshot["linux_entry"])
    for entry in snapshot["windows_entries"]:
        if entry["active"]:
            run("efibootmgr", "-b", entry["id"], "-A")
    current = parse_firmware_boot(
        run("efibootmgr", "-v").stdout, snapshot["efi_partuuids"])
    if (current["boot_order"] != [snapshot["linux_entry"]]
            or current["linux_entry"] != snapshot["linux_entry"]
            or any(entry["active"] for entry in current["windows_entries"])):
        fail("could not verify that UEFI will boot Linux and skip native Windows during recovery")


def restore_firmware_boot(snapshot):
    if not snapshot:
        return
    for entry in snapshot["windows_entries"]:
        run("efibootmgr", "-b", entry["id"],
            "-a" if entry["active"] else "-A")
    if snapshot["boot_order"]:
        run("efibootmgr", "-o", ",".join(snapshot["boot_order"]))
    else:
        run("efibootmgr", "-O")
    current = parse_firmware_boot(
        run("efibootmgr", "-v").stdout, snapshot["efi_partuuids"])
    if (current["boot_order"] != snapshot["boot_order"]
            or current["linux_entry"] != snapshot["linux_entry"]
            or current["windows_entries"] != snapshot["windows_entries"]):
        fail("could not restore the original UEFI boot order and Windows entry states")


def atomic_json(path, data, prefix):
    directory_existed = path.parent.exists()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not directory_existed:
        fsync_directory(path.parent.parent)
    parent_stat = os.lstat(path.parent)
    if not stat.S_ISDIR(parent_stat.st_mode) or parent_stat.st_uid != os.geteuid():
        fail(f"guarded COW state directory is not owned by the effective user: {path.parent}")
    os.chmod(path.parent, 0o700)
    fd, temp_path = tempfile.mkstemp(prefix=prefix, dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(data, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp_path, path)
        fsync_directory(path.parent)
    except Exception:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass
        raise


def journal_path(domain):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", domain):
        fail("invalid domain name for guarded COW journal")
    return JOURNAL_DIR / f"{domain}.json"


def read_journal(domain):
    path = journal_path(domain)
    try:
        directory_stat = os.lstat(path.parent)
    except FileNotFoundError:
        return None
    if (not stat.S_ISDIR(directory_stat.st_mode)
            or directory_stat.st_uid != os.geteuid()
            or stat.S_IMODE(directory_stat.st_mode) != 0o700):
        fail(f"durable guarded COW journal directory is not private: {path.parent}")
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None
    if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1
            or st.st_uid != os.geteuid()
            or stat.S_IMODE(st.st_mode) != 0o600):
        fail(f"guarded COW journal is not a root-owned regular file: {path}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        fail(f"cannot read durable guarded COW journal {path}: {exc}")


def write_state(data):
    # Persist the transaction record before updating volatile /run state. The
    # durable copy is the recovery authority after a crash or power loss.
    if data.get("save_pending") and data.get("save_transaction"):
        atomic_json(journal_path(data["domain"]), data, ".guarded-cow-journal-")
    RUN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    atomic_json(STATE, data, ".guarded-cow-")


def remove_journal(domain):
    path = journal_path(domain)
    try:
        path.unlink()
        fsync_directory(path.parent)
    except FileNotFoundError:
        pass


def validate_overlay(config, check=True):
    try:
        info = json.loads(run(QEMU_IMG, "info", "--output=json", config["overlay"]).stdout)
        st = os.lstat(config["overlay"])
        disk_size = int(run("blockdev", "--getsize64", config["disk"]).stdout.strip())
        if check:
            run(QEMU_IMG, "check", "-q", config["overlay"])
    except Exception as exc:
        fail(f"cannot inspect qcow2 overlay or its backing disk: {exc}")
    if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1
            or st.st_uid != pwd.getpwnam(HELPER_USER).pw_uid
            or stat.S_IMODE(st.st_mode) != 0o600
            or info.get("format") != "qcow2" or info.get("virtual-size") != disk_size
            or info.get("backing-filename") != config["disk"]
            or info.get("backing-filename-format") != "raw"
            or info.get("format-specific", {}).get("data", {}).get("corrupt")):
        fail("overlay ownership, format, backing path, size, or health is not approved")


def guard_options(config, plan_path=None):
    # Raw backing devices need QEMU's host_device backend. Keep file for the
    # regular-file disk images used by disposable tests and local fixtures.
    backing_driver = ("host_device" if stat.S_ISBLK(os.stat(config["disk"]).st_mode)
                      else "file")
    options = ["driver=partition-write-guard",
               f"file.driver={backing_driver}",
               f"file.filename={config['disk']}"]
    options.extend(f"partitions.{index}={part['number']}"
                   for index, part in enumerate(config["partitions"]))
    if plan_path is not None:
        options.append(f"plan-file={plan_path}")
    return ",".join(options)


def overlay_options(config):
    return ",".join(["driver=qcow2", "file.driver=file",
                     f"file.filename={config['overlay']}"])


def disk_inventory(config):
    try:
        tree = json.loads(run(
            "lsblk", "--json", "--tree", "--bytes", "--paths", "--output",
            "PATH,TYPE,SIZE,LOG-SEC,PHY-SEC,MODEL,SERIAL,WWN,PTTYPE,PTUUID,PARTN,PARTUUID,PARTTYPE",
            config["disk"]).stdout)["blockdevices"]
    except Exception as exc:
        fail(f"cannot inspect the backing disk identity and GPT: {exc}")
    if len(tree) != 1:
        fail("backing disk identity did not resolve to one block device")
    disk = tree[0]
    if (disk.get("type") != "disk" or os.path.realpath(disk.get("path", ""))
            != os.path.realpath(config["disk"]) or disk.get("pttype") != "gpt"):
        fail("configured backing device is not the expected GPT whole disk")
    sector_size = int(disk.get("log-sec") or 0)
    size = int(disk.get("size") or 0)
    if (sector_size < 512 or sector_size > 4096
            or sector_size & (sector_size - 1) or not size or size % sector_size):
        fail("backing disk has unsupported logical-sector geometry")
    if not (disk.get("wwn") or disk.get("serial")):
        fail("backing disk has no stable hardware identity (WWN or serial)")
    if not disk.get("ptuuid"):
        fail("backing disk has no GPT disk identifier")

    raw_partitions, disk_guid, metadata, gpt_sha256 = read_gpt(
        config["disk"], sector_size, size)

    # Linux sysfs reports partition starts and sizes in fixed 512-byte units,
    # regardless of the device's logical sector size. Keep that conversion
    # distinct from the live logical-sector size used for GPT LBAs and COW.
    kernel_partitions = []
    for node in disk.get("children") or []:
        if node.get("type") != "part":
            continue
        number = int(node.get("partn") or 0)
        if not number or not node.get("partuuid") or not node.get("parttype"):
            fail("backing disk contains a partition with incomplete GPT identity")
        try:
            sysfs_name = os.path.basename(os.path.realpath(node["path"]))
            with open(f"/sys/class/block/{sysfs_name}/start", encoding="ascii") as stream:
                start_bytes = int(stream.read().strip()) * 512
            with open(f"/sys/class/block/{sysfs_name}/size", encoding="ascii") as stream:
                size_bytes = int(stream.read().strip()) * 512
        except Exception as exc:
            fail(f"cannot read GPT partition {number} bounds from sysfs: {exc}")
        if start_bytes % sector_size or size_bytes % sector_size:
            fail(f"GPT partition {number} is not aligned to the logical sector size")
        kernel_partitions.append({"number": number, "path": node["path"],
                                  "partuuid": node["partuuid"].lower(),
                                  "type": node["parttype"].lower(),
                                  "start_bytes": start_bytes,
                                  "size_bytes": size_bytes})
    kernel_partitions.sort(key=lambda part: part["number"])
    raw_by_number = {part["number"]: part for part in raw_partitions}
    if len(kernel_partitions) != len(raw_partitions):
        fail("kernel partition nodes do not match the live GPT partition count")
    for part in kernel_partitions:
        raw = raw_by_number.get(part["number"])
        if (raw is None or raw["partuuid"] != part["partuuid"]
                or raw["type"] != part["type"]
                or raw["start_bytes"] != part["start_bytes"]
                or raw["size_bytes"] != part["size_bytes"]):
            fail(f"kernel partition {part['number']} does not match the live GPT")
    partitions = []
    for part in raw_partitions:
        kernel = next((entry for entry in kernel_partitions
                       if entry["number"] == part["number"]), None)
        if kernel is None:
            fail(f"GPT partition {part['number']} has no kernel partition device")
        partitions.append({**part, "path": kernel["path"]})
    by_number = {part["number"]: part for part in partitions}
    for configured in config["partitions"]:
        live = by_number.get(configured["number"])
        if (live is None or live["partuuid"] != configured["partuuid"]
                or live["type"] != configured["type"]):
            fail(f"configured GPT partition {configured['number']} identity changed")

    if disk["ptuuid"].lower() != disk_guid:
        fail("kernel GPT disk identifier does not match the on-disk primary GPT")
    identity = {key: disk.get(key) for key in
                ("path", "size", "log-sec", "phy-sec", "model", "serial", "wwn", "ptuuid")}
    identity["gpt_sha256"] = gpt_sha256
    return {"identity": identity, "sector_size": sector_size,
            "size_bytes": size, "size_lba": size // sector_size,
            "partitions": partitions, "gpt_metadata": metadata}


def read_gpt(path, sector_size, disk_size):
    def parse_header(stream, lba):
        stream.seek(lba * sector_size)
        raw = stream.read(sector_size)
        if len(raw) != sector_size or raw[:8] != b"EFI PART":
            fail(f"invalid GPT header at LBA {lba}")
        header_size = struct.unpack_from("<I", raw, 12)[0]
        expected_crc = struct.unpack_from("<I", raw, 16)[0]
        if header_size < 92 or header_size > sector_size:
            fail(f"invalid GPT header size at LBA {lba}")
        checked = bytearray(raw[:header_size])
        checked[16:20] = bytes(4)
        if zlib.crc32(checked) & 0xffffffff != expected_crc:
            fail(f"GPT header CRC failed at LBA {lba}")
        current, backup, first_usable, last_usable = struct.unpack_from(
            "<QQQQ", raw, 24)
        disk_guid = str(uuid.UUID(bytes_le=raw[56:72]))
        table_lba = struct.unpack_from("<Q", raw, 72)[0]
        entry_count, entry_size, table_crc = struct.unpack_from("<III", raw, 80)
        disk_sectors = disk_size // sector_size
        if (current != lba or backup >= disk_sectors or backup == current
                or first_usable < 2 or first_usable > last_usable
                or last_usable >= disk_sectors - 1 or not entry_count
                or entry_count > 4096 or entry_size < 128
                or entry_size > 4096 or entry_size & 7):
            fail(f"invalid GPT bounds or entry geometry at LBA {lba}")
        table_bytes = entry_count * entry_size
        table_offset = table_lba * sector_size
        if table_offset > disk_size or table_bytes > disk_size - table_offset:
            fail(f"GPT entry array is out of bounds at LBA {lba}")
        stream.seek(table_offset)
        table = stream.read(table_bytes)
        if len(table) != table_bytes or zlib.crc32(table) & 0xffffffff != table_crc:
            fail(f"GPT entry-array CRC failed at LBA {lba}")
        return {"current": current, "backup": backup,
                "first_usable": first_usable, "last_usable": last_usable,
                "disk_guid": disk_guid, "table_lba": table_lba,
                "entry_count": entry_count, "entry_size": entry_size,
                "table_bytes": table_bytes, "table": table, "raw": raw}

    with open(path, "rb", buffering=0) as stream:
        protective_mbr = stream.read(sector_size)
        primary = parse_header(stream, 1)
        backup = parse_header(stream, primary["backup"])
    if (protective_mbr[510:512] != b"\x55\xaa"
            or protective_mbr[450] != 0xee
            or struct.unpack_from("<I", protective_mbr, 454)[0] != 1):
        fail("protective MBR signature or GPT partition entry is invalid")
    if (primary["backup"] != disk_size // sector_size - 1
            or backup["current"] != disk_size // sector_size - 1
            or backup["backup"] != primary["current"]
            or backup["disk_guid"] != primary["disk_guid"]
            or backup["first_usable"] != primary["first_usable"]
            or backup["last_usable"] != primary["last_usable"]
            or backup["entry_count"] != primary["entry_count"]
            or backup["entry_size"] != primary["entry_size"]
            or backup["table"] != primary["table"]):
        fail("primary and backup GPT metadata do not agree")
    primary_table_end = (primary["table_lba"] * sector_size +
                         primary["table_bytes"] + sector_size - 1) // sector_size
    backup_table_end = (backup["table_lba"] * sector_size +
                        backup["table_bytes"] + sector_size - 1) // sector_size
    if (primary["table_lba"] < 2 or primary_table_end > primary["first_usable"]
            or backup["table_lba"] <= backup["last_usable"]
            or backup_table_end > backup["current"]):
        fail("GPT entry arrays overlap usable or partitioned disk areas")
    partitions = []
    partuuids = set()
    for index in range(primary["entry_count"]):
        entry = primary["table"][index * primary["entry_size"]:
                                  (index + 1) * primary["entry_size"]]
        if entry[:16] == bytes(16):
            continue
        first, last = struct.unpack_from("<QQ", entry, 32)
        if (first < primary["first_usable"] or last > primary["last_usable"]
                or first > last):
            fail(f"GPT partition {index + 1} has invalid bounds")
        partuuid = str(uuid.UUID(bytes_le=entry[16:32]))
        if partuuid in partuuids:
            fail(f"GPT contains duplicate partition UUID {partuuid}")
        partuuids.add(partuuid)
        name = entry[56:primary["entry_size"]].decode(
            "utf-16-le", errors="replace").rstrip("\x00")
        partitions.append({"number": index + 1,
                           "partuuid": partuuid,
                           "type": str(uuid.UUID(bytes_le=entry[:16])),
                           "start_bytes": first * sector_size,
                           "size_bytes": (last - first + 1) * sector_size,
                           "start_lba": first, "end_lba": last + 1,
                           "name": name})
    partitions.sort(key=lambda part: part["start_lba"])
    for left, right in zip(partitions, partitions[1:]):
        if left["end_lba"] > right["start_lba"]:
            fail(f"GPT partitions {left['number']} and {right['number']} overlap")
    metadata = [{"start_bytes": 0, "end_bytes": sector_size, "name": "protective MBR"},
                {"start_bytes": sector_size, "end_bytes": 2 * sector_size,
                 "name": "primary GPT header"},
                {"start_bytes": primary["table_lba"] * sector_size,
                 "end_bytes": primary["table_lba"] * sector_size + primary["table_bytes"],
                 "name": "primary GPT entry array"},
                {"start_bytes": backup["table_lba"] * sector_size,
                 "end_bytes": backup["table_lba"] * sector_size + backup["table_bytes"],
                 "name": "backup GPT entry array"},
                {"start_bytes": primary["backup"] * sector_size,
                 "end_bytes": (primary["backup"] + 1) * sector_size,
                 "name": "backup GPT header"}]
    fingerprint = hashlib.sha256(
        protective_mbr + primary["raw"] + primary["table"] +
        backup["raw"] + backup["table"]).hexdigest()
    return partitions, primary["disk_guid"], metadata, fingerprint


def host_disk_state(inventory, config):
    allowed = {part["number"] for part in config["partitions"]}
    allowed_mm = set()
    for part in inventory["partitions"]:
        if part["number"] in allowed:
            st = os.stat(part["path"])
            allowed_mm.add(f"{os.major(st.st_rdev)}:{os.minor(st.st_rdev)}")
    swaps = []
    try:
        swap_names = run("swapon", "--show=NAME", "--noheadings", "--raw").stdout.splitlines()
    except Exception as exc:
        fail(f"cannot inspect host swap state: {exc}")
    for name in swap_names:
        try:
            st = os.stat(os.path.realpath(name))
            if stat.S_ISBLK(st.st_mode):
                mm = f"{os.major(st.st_rdev)}:{os.minor(st.st_rdev)}"
            elif stat.S_ISREG(st.st_mode):
                mm = run("findmnt", "--noheadings", "--output", "MAJ:MIN",
                         "--target", name).stdout.strip()
            else:
                mm = "unknown"
        except Exception:
            mm = "unknown"
        swaps.append({"path": name, "major_minor": mm,
                      "configured_partition": mm in allowed_mm})
    mounts = mount_table()
    rows = []
    for part in inventory["partitions"]:
        path = part["path"]
        st = os.stat(path)
        mm = f"{os.major(st.st_rdev)}:{os.minor(st.st_rdev)}"
        part_mounts = [row for row in mounts if row["mm"] == mm]
        rows.append({"number": part["number"], "path": path,
                     "allowed": part["number"] in allowed,
                     "mounts": [{"target": row["target"],
                                 "mode": "ro" if is_ro(row) else "rw"}
                                for row in part_mounts],
                     "swap": any(item["major_minor"] == mm for item in swaps)})
    disk_stat = os.stat(config["disk"])
    disk_mm = f"{os.major(disk_stat.st_rdev)}:{os.minor(disk_stat.st_rdev)}"
    whole_disk_mounts = [row for row in mounts if row["mm"] == disk_mm]
    if whole_disk_mounts:
        fail("the whole backing disk is mounted on the host")
    if any(row["allowed"] and (row["mounts"] or row["swap"]) for row in rows):
        fail("a configured writable partition is mounted or used as swap")
    return {"partitions": rows, "swap": swaps}


def overlay_fingerprint(config):
    info = json.loads(run(QEMU_IMG, "info", "--output=json", config["overlay"]).stdout)
    st = os.stat(config["overlay"])
    return {"path": config["overlay"], "device": st.st_dev,
            "inode": st.st_ino, "size": st.st_size,
            "mtime_ns": st.st_mtime_ns, "format": info.get("format"),
            "backing_filename": info.get("backing-filename"),
            "backing_format": info.get("backing-filename-format"),
            "virtual_size": info.get("virtual-size"),
            "cluster_size": info.get("cluster-size"),
            "health": "qemu-img check passed"}


def make_write_plan(config, progress=False):
    inventory_before = disk_inventory(config)
    RUN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, plan_path = tempfile.mkstemp(prefix=".review-plan-", dir=RUN_DIR)
    os.close(fd)
    os.unlink(plan_path)
    try:
        args = [QEMU_IMG, "commit"]
        if progress:
            # This is QEMU's traversal progress through the virtual disk while
            # it records the guarded plan. It is not physical-write progress.
            args.append("-p")
        args.extend(("-d", "--image-opts", "--backing-image-opts",
                     guard_options(config, plan_path), overlay_options(config)))
        result = subprocess.run(
            args, check=False, text=True,
            stdout=sys.stderr if progress else subprocess.PIPE,
            stderr=subprocess.PIPE)
        if result.returncode:
            fail("guarded dry-run commit failed: " +
                 (result.stderr.strip() or (result.stdout or "").strip() or
                  f"exit status {result.returncode}"))
        with open(plan_path, "rb") as stream:
            raw = stream.read()
        records = [json.loads(line) for line in raw.splitlines()]
        if (len(records) < 2 or records[0] != {
                "type": "qemu-partition-write-guard-plan", "version": 1}
                or records[-1].get("type") != "flush"
                or records[-1].get("event_count") != len(records) - 2):
            fail("guarded dry-run plan is incomplete or malformed")
        extents = records[1:-1]
        inventory = disk_inventory(config)
        if inventory != inventory_before:
            fail("backing disk identity or GPT layout changed during dry-run")
        allowed = [next(part for part in inventory["partitions"]
                        if part["number"] == configured["number"])
                   for configured in config["partitions"]]
        sector_size = inventory["sector_size"]
        for extent in extents:
            if (extent.get("type") != "write" or
                    extent.get("operation") not in ("write", "write-zeroes", "discard") or
                    type(extent.get("offset")) is not int or
                    type(extent.get("length")) is not int or
                    extent["offset"] < 0 or extent["length"] <= 0 or
                    extent["offset"] % sector_size or extent["length"] % sector_size):
                fail("dry-run returned an invalid or non-sector-aligned write extent")
            end = extent["offset"] + extent["length"]
            if not any(extent["offset"] >= part["start_bytes"] and
                       end <= part["start_bytes"] + part["size_bytes"]
                       for part in allowed):
                fail("dry-run includes a write extent outside one configured GPT partition")
            extent["start_lba"] = extent["offset"] // sector_size
            extent["end_lba"] = end // sector_size
        extents.sort(key=lambda extent: (extent["offset"], extent["length"],
                                         extent["operation"]))
        return raw, extents, inventory
    finally:
        try:
            os.unlink(plan_path)
        except FileNotFoundError:
            pass


def write_plan_sha256(extents):
    canonical = {"type": "qemu-partition-write-guard-plan",
                 "version": 1, "extents": extents}
    encoded = json.dumps(canonical, sort_keys=True,
                         separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def base_content_fingerprint(disk, extents, progress_label=None):
    digest = hashlib.sha256()
    ordered_extents = sorted(extents, key=lambda item: (item["offset"],
                                                        item["length"]))
    total = sum(extent["length"] for extent in ordered_extents)
    completed = 0
    reported = -5
    if progress_label:
        print(f"Guarded COW save: {progress_label}: 0% (0/{total} bytes)",
              file=sys.stderr, flush=True)
    fd = os.open(disk, os.O_RDONLY | os.O_CLOEXEC)
    try:
        for extent in ordered_extents:
            offset = extent["offset"]
            remaining = extent["length"]
            digest.update(struct.pack(">QQ", offset, remaining))
            while remaining:
                chunk = os.pread(fd, min(1024 * 1024, remaining), offset)
                if not chunk:
                    fail("backing disk ended while fingerprinting planned commit extents")
                digest.update(chunk)
                offset += len(chunk)
                remaining -= len(chunk)
                completed += len(chunk)
                if progress_label and total:
                    percent = completed * 100 // total
                    if percent >= reported + 5 or completed == total:
                        reported = percent
                        print(f"\rGuarded COW save: {progress_label}: "
                              f"{percent}% ({completed}/{total} bytes)",
                              end="", file=sys.stderr, flush=True)
    finally:
        os.close(fd)
    if progress_label:
        print(file=sys.stderr, flush=True)
    return digest.hexdigest()


def base_fingerprint_extents(config, inventory):
    allowed_numbers = {part["number"] for part in config["partitions"]}
    extents = [{"offset": part["start_bytes"], "length": part["size_bytes"],
                "scope": f"GPT partition {part['number']}"}
               for part in inventory["partitions"]
               if part["number"] in allowed_numbers]
    extents.extend({"offset": item["start_bytes"],
                    "length": item["end_bytes"] - item["start_bytes"],
                    "scope": item["name"]}
                   for item in inventory["gpt_metadata"])
    extents.sort(key=lambda item: (item["offset"], item["length"],
                                   item["scope"]))
    return extents


def base_baseline_path(config):
    return Path(config["overlay"] + ".pwg-base.json")


def disk_metadata_stat_keys(mode):
    # Block-device node timestamps are not a reliable record of changes to the
    # configured partition ranges. The content fingerprint below covers those
    # ranges and GPT metadata directly. Keep timestamp checks for regular-file
    # disposable backings, where they detect write-and-restore activity.
    keys = ("st_mode", "st_dev", "st_ino", "st_rdev", "st_size")
    if not stat.S_ISBLK(mode):
        keys += ("st_mtime_ns", "st_ctime_ns")
    return keys


def disk_metadata_matches(baseline, current):
    keys = ("mode", "device", "inode", "rdev", "size")
    if not stat.S_ISBLK(current.get("mode", 0)):
        keys += ("mtime_ns", "ctime_ns")
    return all(baseline.get(key) == current.get(key) for key in keys)


def capture_base_baseline(config, inventory=None, progress=False,
                          progress_label="Checking the COW-root baseline"):
    inventory = inventory or disk_inventory(config)
    disk_stat_before = os.stat(config["disk"])
    coverage = base_fingerprint_extents(config, inventory)
    content_sha256 = base_content_fingerprint(
        config["disk"], coverage,
        progress_label=progress_label if progress else None)
    disk_stat_after = os.stat(config["disk"])
    inventory_after = disk_inventory(config)
    stat_keys = disk_metadata_stat_keys(disk_stat_after.st_mode)
    if (any(getattr(disk_stat_before, key) != getattr(disk_stat_after, key)
            for key in stat_keys) or inventory_after != inventory):
        fail("backing disk identity, metadata, or GPT changed while capturing its COW-root baseline")
    partitions = [{key: part[key] for key in
                   ("number", "partuuid", "type", "start_bytes", "size_bytes")}
                  for part in inventory["partitions"]
                  if part["number"] in {p["number"] for p in config["partitions"]}]
    disk_metadata = {"mode": disk_stat_after.st_mode,
                     "device": disk_stat_after.st_dev,
                     "inode": disk_stat_after.st_ino,
                     "rdev": disk_stat_after.st_rdev,
                     "size": disk_stat_after.st_size}
    if not stat.S_ISBLK(disk_stat_after.st_mode):
        disk_metadata.update(mtime_ns=disk_stat_after.st_mtime_ns,
                             ctime_ns=disk_stat_after.st_ctime_ns)
    return {
        "schema": "qemu-guarded-cow-base-v1",
        "captured_at_unix_ns": time.time_ns(),
        "disk_identity": inventory["identity"],
        "disk_geometry": {"size_bytes": inventory["size_bytes"],
                          "logical_sector_size": inventory["sector_size"],
                          "size_lba": inventory["size_lba"]},
        "disk_metadata": disk_metadata,
        "partitions": partitions,
        "coverage_extents": coverage,
        "content_sha256": content_sha256,
        "coverage": "all configured writable GPT partitions and GPT metadata",
    }


def stage_base_baseline(config, baseline):
    path = base_baseline_path(config)
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=".pwg-base-", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(baseline, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
    except Exception:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass
        raise
    return temp_path


def fsync_directory(directory):
    dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def store_base_baseline(config, baseline):
    path = base_baseline_path(config)
    temp_path = stage_base_baseline(config, baseline)
    try:
        os.replace(temp_path, path)
        fsync_directory(path.parent)
    finally:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass


def load_base_baseline(config):
    path = base_baseline_path(config)
    try:
        st = os.lstat(path)
        if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1
                or st.st_uid != os.geteuid()
                or stat.S_IMODE(st.st_mode) != 0o600):
            fail("COW-root baseline ownership, mode, or file type is not approved")
        baseline = json.loads(path.read_text(encoding="utf-8"))
    except GuardError:
        raise
    except Exception as exc:
        fail(f"cannot read the COW-root baseline; physical save is blocked: {exc}")
    if baseline.get("schema") != "qemu-guarded-cow-base-v1":
        fail("COW-root baseline has an unsupported schema; physical save is blocked")
    return baseline


def verify_root_baseline(config, inventory=None, progress=False,
                         progress_label="Checking the COW-root baseline"):
    baseline = load_base_baseline(config)
    current = capture_base_baseline(config, inventory, progress=progress,
                                    progress_label=progress_label)
    keys = ("disk_identity", "disk_geometry", "disk_metadata", "partitions",
            "coverage_extents", "content_sha256", "coverage")
    changed = [key for key in keys if key != "disk_metadata"
               and baseline.get(key) != current.get(key)]
    if not disk_metadata_matches(baseline.get("disk_metadata", {}),
                                 current.get("disk_metadata", {})):
        changed.append("disk_metadata")
    if changed:
        fail("backing disk differs from its COW-root baseline (" +
             ", ".join(changed) + "); physical save is blocked pending reconciliation")
    return baseline


def base_baseline_digest(config):
    path = base_baseline_path(config)
    if not os.path.lexists(path):
        return None
    try:
        load_base_baseline(config)
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError as exc:
        fail(f"cannot fingerprint the COW-root baseline record: {exc}")


def offline_review_state(domain, config, devices):
    """Create /run isolation metadata without booting or starting the VM."""
    if read_journal(domain) is not None:
        fail("an incomplete guarded COW save must be recovered before a new review")
    verify_no_allowed_swap(devices)
    verify_no_block_device_users(config, devices)
    verify_partitions_not_writable(devices, config["partitions"])
    if any(mounts_for(devices, part["number"])
           for part in config["partitions"]):
        fail("configured writable partitions must be unmounted for offline save review")
    verify_qemu_readonly(config["disk"])
    return {"domain": domain, "disk": config["disk"],
            "partitions": config["partitions"], "mounts": [],
            "disk_acl": disk_acl(config["disk"]), "guest_active": False,
            "last_shutdown_reason": "unknown", "snapshot_eligible": False}


def disk_map_svg(inventory, config, extents):
    width, left, right = 1100, 70, 1070
    usable = right - left
    total = inventory["size_bytes"]
    sector = inventory["sector_size"]
    allowed = {part["number"] for part in config["partitions"]}
    scale = lambda offset: left + usable * offset / total
    parts = inventory["partitions"]
    segments = []
    cursor = 0
    for part in parts:
        start, end = part["start_bytes"], part["start_bytes"] + part["size_bytes"]
        if start > cursor:
            segments.append((cursor, start, "unallocated", "#e6e8eb"))
        color = "#75bd8c" if part["number"] in allowed else "#8e9aa6"
        segments.append((start, end, f"partition {part['number']}", color))
        cursor = end
    if cursor < total:
        segments.append((cursor, total, "unallocated", "#e6e8eb"))
    height = max(200, 180 + 14 * len(parts))
    svg = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">',
           '<rect width="100%" height="100%" fill="white"/>',
           '<text x="70" y="24" font-family="sans-serif" font-size="16">Live GPT disk map (linear LBA scale)</text>',
           f'<text x="{left}" y="42" font-family="monospace" font-size="11">LBA 0</text>',
           f'<text x="{right}" y="42" text-anchor="end" font-family="monospace" font-size="11">LBA {inventory["size_lba"] - 1}</text>']
    for start, end, title, color in segments:
        x1, x2 = scale(start), scale(end)
        svg.append(f'<rect x="{x1:.4f}" y="50" width="{max(0.02, x2-x1):.4f}" height="52" fill="{color}" stroke="#333" stroke-width="0.25"><title>{title}: bytes {start}..{end - 1}</title></rect>')
    # Mark protective MBR, primary and backup GPT metadata, scaled to their
    # actual LBAs. Exact extents remain listed below when marks are subpixel.
    for item in inventory["gpt_metadata"]:
        start, end = item["start_bytes"], item["end_bytes"]
        x = scale(start)
        svg.append(f'<line x1="{x:.4f}" y1="46" x2="{x:.4f}" y2="108" stroke="#ed8b00" stroke-width="2"><title>{item["name"]}: LBA {start // sector}..{(end-1) // sector}</title></line>')
    for extent in extents:
        x1 = scale(extent["offset"])
        x2 = scale(extent["offset"] + extent["length"])
        svg.append(f'<line x1="{x1:.4f}" y1="77" x2="{x2:.4f}" y2="77" stroke="#c3262e" stroke-width="5"><title>Planned {extent["operation"]}: LBA {extent["start_lba"]}..{extent["end_lba"] - 1}</title></line>')
    svg += ['<rect x="70" y="118" width="14" height="12" fill="#75bd8c"/><text x="90" y="129" font-family="sans-serif" font-size="12">Configured writable (eligible only)</text>',
            '<rect x="290" y="118" width="14" height="12" fill="#8e9aa6"/><text x="310" y="129" font-family="sans-serif" font-size="12">Other GPT partition (off-limits)</text>',
            '<rect x="550" y="118" width="14" height="12" fill="#e6e8eb"/><text x="570" y="129" font-family="sans-serif" font-size="12">Unallocated / other area</text>',
            '<line x1="790" y1="124" x2="810" y2="124" stroke="#ed8b00" stroke-width="3"/><text x="816" y="129" font-family="sans-serif" font-size="12">GPT metadata</text>',
            '<line x1="930" y1="124" x2="950" y2="124" stroke="#c3262e" stroke-width="5"/><text x="956" y="129" font-family="sans-serif" font-size="12">Planned write</text>',
            '<text x="70" y="157" font-family="sans-serif" font-size="12">GPT partitions:</text>']
    y = 176
    for part in parts:
        access = "eligible" if part["number"] in allowed else "off-limits"
        svg.append(f'<text x="80" y="{y}" font-family="monospace" font-size="11">p{part["number"]} {access}: LBA {part["start_lba"]}..{part["end_lba"] - 1} ({part["size_bytes"]} bytes; PARTUUID {part["partuuid"]})</text>')
        y += 14
    svg.append(f'<text x="620" y="157" font-family="sans-serif" font-size="12">{len(extents)} exact planned extents are listed in the report</text>')
    svg.append('</svg>')
    return "\n".join(svg)


def review_action(domain):
    assert_vm_off(domain)
    config = parse_config(domain)
    helper_info = helper_identity()
    recovery_guard = recovery_guard_identity()
    validate_overlay(config)
    if not STATE.exists():
        devices = part_devices(config)
        state = offline_review_state(domain, config, devices)
        write_state(state)
    else:
        try:
            state = json.loads(STATE.read_text(encoding="utf-8"))
        except Exception as exc:
            fail(f"cannot read guarded isolation state: {exc}")
    if (state.get("domain") != domain or state.get("disk") != config["disk"]
            or state.get("partitions") != config["partitions"]
            or state.get("guest_active") or
            state.get("save_pending") or state.get("save_complete")
            or state.get("discard_complete")):
        fail("guarded isolation state does not match a stopped, unsaved VM")
    devices = part_devices(config)
    verify_no_allowed_swap(devices)
    verify_no_block_device_users(config, devices)
    verify_partitions_not_writable(devices, config["partitions"])
    if any(mounts_for(devices, part["number"])
           for part in config["partitions"]):
        fail("configured writable partitions must be unmounted for save review")
    verify_qemu_readonly(config["disk"])
    _raw_plan, extents, inventory = make_write_plan(config)
    firmware_boot = firmware_boot_snapshot(config, inventory)
    root_baseline_digest = base_baseline_digest(config)
    root_baseline = (verify_root_baseline(config, inventory)
                     if root_baseline_digest is not None else None)
    precommit_base_sha256 = (
        root_baseline["content_sha256"] if root_baseline else
        base_content_fingerprint(
            config["disk"], base_fingerprint_extents(config, inventory)))
    base_fingerprint = base_content_fingerprint(config["disk"], extents)
    host = host_disk_state(inventory, config)
    overlay = overlay_fingerprint(config)
    token = secrets.token_urlsafe(32)
    now = int(time.time())
    notice = (
        "Offline review only: no physical-disk writes were issued and Windows "
        "was not started. The review ID is valid for one hour. Commit checks "
        "the ID and current VM, device, GPT, and host-isolation safety state, "
        "but does not repeat the full QEMU write traversal or content scans. "
        "Raw disk writes after review are not detected; decide whether the "
        "review is recent enough before explicitly confirming commit."
        if PHYSICAL_COMMIT_ENABLED else
        "Dry-run only: no physical-disk writes were issued. This review does "
        "not prove a real commit will succeed. Physical commit remains disabled "
        "until disposable-disk tests cover the full commit, interruption, "
        "resume, and boot fail-closed recovery path."
    )
    if firmware_boot:
        notice += (
            " Before the first physical write, the helper will temporarily make "
            "the identified Linux recovery entry the only automatic UEFI boot "
            "target and deactivate Windows entries for this disk; it restores "
            "their original states only after the save and host-state restoration "
            "complete."
        )
    report = {"schema": "qemu-guarded-cow-review-v1", "review_id": token,
              "domain": domain, "created_at": now, "expires_at": now + REVIEW_TTL,
              "physical_disk_written": False,
              "commit_enabled": PHYSICAL_COMMIT_ENABLED,
              "notice": notice,
              "helper": helper_info,
              "recovery_guard": recovery_guard,
              "disk": {**inventory["identity"], "size_bytes": inventory["size_bytes"],
                       "logical_sector_size": inventory["sector_size"],
                       "size_lba": inventory["size_lba"]},
              "shutdown": {"reason": state.get("last_shutdown_reason", "unknown"),
                           "clean_snapshot_eligible":
                               state.get("snapshot_eligible") is True},
              "firmware_boot": firmware_boot,
              "overlay": {**overlay, "health": "qemu-img check passed"},
              "partitions": inventory["partitions"], "host_state": host,
              "guard": {"driver": "partition-write-guard",
                        "configured_partitions": config["partitions"],
                        "plan_sha256": write_plan_sha256(extents),
                        "base_content_sha256": base_fingerprint,
                        "base_content_coverage": "planned commit extents at review time",
                        "base_root_baseline_status":
                            "verified" if root_baseline else "missing-legacy",
                        "base_root_baseline_sha256": root_baseline_digest,
                        "base_root_content_sha256":
                            root_baseline["content_sha256"] if root_baseline else None,
                        "base_root_content_coverage":
                            root_baseline["coverage"] if root_baseline else
                            "not available; this legacy COW root predates baseline capture",
                        "base_precommit_sha256": precommit_base_sha256,
                        "base_precommit_coverage":
                            "configured writable partitions and GPT metadata at review time",
                        "base_root_capture_basis":
                            (root_baseline.get(
                                "capture_basis", "captured at guarded COW root creation")
                             if root_baseline else None),
                        "base_root_captured_at_unix_ns":
                            (root_baseline["captured_at_unix_ns"]
                             if root_baseline else None),
                        "base_root_disk_metadata":
                            (root_baseline["disk_metadata"] if root_baseline else None)},
              "planned_extents": extents}
    report["disk_map_svg"] = disk_map_svg(inventory, config, extents)
    REVIEW_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(REVIEW_DIR, 0o700)
    review_path = REVIEW_DIR / (hashlib.sha256(token.encode()).hexdigest() + ".json")
    stored = {"report": report, "plan_sha256": report["guard"]["plan_sha256"]}
    fd = os.open(review_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(stored, stream, separators=(",", ":"))
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    if sys.stdout.isatty():
        # Keep an interactive terminal readable while retaining the complete
        # extent-by-extent report for inspection. Virt-manager captures stdout
        # and continues to receive the machine-readable JSON below.
        report_name = ("qemu-guarded-cow-review-" +
                       hashlib.sha256(domain.encode("utf-8")).hexdigest()[:12] +
                       "-" + token[:8] + ".json")
        report_path = Path("/var/tmp") / report_name
        report_fd = os.open(report_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                            getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(report_fd, "w", encoding="utf-8") as stream:
            json.dump(report, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())

        planned_bytes = sum(extent["length"] for extent in extents)
        bytes_by_partition = {}
        for extent in extents:
            end = extent["offset"] + extent["length"]
            for part in inventory["partitions"]:
                start = part["start_bytes"]
                part_end = start + part["size_bytes"]
                if extent["offset"] >= start and end <= part_end:
                    number = part["number"]
                    bytes_by_partition[number] = (
                        bytes_by_partition.get(number, 0) + extent["length"])
                    break
        print("COW save review complete; no physical-disk writes were made.")
        print(f"VM: {domain}; commit enabled: "
              f"{'yes' if report['commit_enabled'] else 'no'}")
        print(f"Plan: {len(extents)} extents, {planned_bytes} bytes total")
        for number, byte_count in sorted(bytes_by_partition.items()):
            print(f"  p{number}: {byte_count} bytes")
        print(f"Full report: {report_path} (root-readable; use sudo to inspect)")
        print(f"Review ID: {token}")
        print("Commit only after reviewing the full report; this ID expires in one hour.")
    else:
        print(json.dumps(report, separators=(",", ":")))


def commit_review(domain, token, progress=False):
    if not PHYSICAL_COMMIT_ENABLED:
        fail("physical COW commit is disabled until the exact installed QEMU and helper pass disposable-disk success, failure, and retry validation")
    if progress:
        print("Guarded COW save: validating review authorization and current safety conditions; no writes yet.",
              file=sys.stderr, flush=True)
    if not re.fullmatch(r"[A-Za-z0-9_-]{40,60}", token):
        fail("invalid or missing review token")
    review_path = REVIEW_DIR / (hashlib.sha256(token.encode()).hexdigest() + ".json")
    state = None
    if STATE.exists():
        try:
            state = json.loads(STATE.read_text(encoding="utf-8"))
        except Exception as exc:
            fail(f"cannot read guarded isolation state: {exc}")
    durable = read_journal(domain)
    if durable is not None and durable.get("save_pending"):
        state = durable
    pending = bool(state and state.get("save_pending")
                   and not state.get("save_complete"))
    transaction = state.get("save_transaction", {}) if pending else {}
    try:
        saved = json.loads(review_path.read_text(encoding="utf-8"))
        previous = saved["report"]
    except Exception as exc:
        previous = transaction.get("review_report")
        if previous is None:
            fail(f"cannot load the reviewed save plan: {exc}")
    if pending:
        if transaction.get("review_id") != token:
            fail("pending save belongs to a different review; manual reconciliation is required")
    elif previous.get("expires_at", 0) < int(time.time()):
        fail("save review expired; review again before starting a physical commit")
    current_helper = helper_identity(require_source=not pending)
    reviewed_helper = previous.get("helper", {})
    same_installed_helper = all(
        current_helper.get(key) == reviewed_helper.get(key)
        for key in ("path", "sha256", "installed", "manifest_sha256"))
    if (not same_installed_helper
            or (not pending and reviewed_helper != current_helper)
            or (current_helper.get("installed") and not pending
                and current_helper.get("source_match") is not True)):
        fail("guarded COW helper or its source changed after review")
    current_recovery_guard = recovery_guard_identity(require_active=not pending)
    reviewed_recovery_guard = previous.get("recovery_guard", {})
    same_recovery_guard = (
        current_recovery_guard.get("path") == reviewed_recovery_guard.get("path")
        and current_recovery_guard.get("sha256") == reviewed_recovery_guard.get("sha256")
        and current_recovery_guard.get("enabled") == reviewed_recovery_guard.get("enabled")
        and current_recovery_guard.get("failure_target") ==
            reviewed_recovery_guard.get("failure_target")
        and current_recovery_guard.get("effective_properties") ==
            reviewed_recovery_guard.get("effective_properties"))
    if not same_recovery_guard:
        fail("early-boot guarded COW recovery service changed after review")
    assert_vm_off(domain)
    config = parse_config(domain)
    phase = transaction.get("phase") if pending else "merge-pending"
    if pending and config["overlay"] != transaction.get(
            "overlay", {}).get("path", previous.get("overlay", {}).get("path")):
        fail("configured overlay path changed during an incomplete save")
    if phase in ("firmware-guarding", "merge-pending", "merge-interrupted"):
        validate_overlay(config, check=False)
    elif phase == "replacement-complete":
        validate_overlay(config)
    elif phase not in ("merge-complete", "replacement-pending",
                       "replacement-interrupted"):
        fail(f"unknown guarded COW recovery phase {phase!r}; manual reconciliation is required")
    if progress:
        print("Guarded COW save: checking disk identity, overlay metadata, and host isolation; no writes yet.",
              file=sys.stderr, flush=True)
    if state is None:
        fail("guarded isolation state is missing; refusing physical commit")
    if (state.get("domain") != domain or state.get("disk") != config["disk"]
            or state.get("partitions") != config["partitions"]
            or state.get("guest_active") or state.get("save_complete")
            or state.get("discard_complete")):
        fail("guarded isolation state changed after review")
    devices = part_devices(config)
    verify_no_allowed_swap(devices)
    verify_no_block_device_users(config, devices)
    verify_partitions_not_writable(devices, config["partitions"])
    if any(mounts_for(devices, part["number"])
           for part in config["partitions"]):
        fail("configured writable partitions are no longer unmounted")
    verify_qemu_readonly(config["disk"])

    # A review is the user's authorization for its recorded plan during the
    # stated validity window. Do not rerun QEMU's full commit traversal or hash
    # disk contents here: those operations can take many minutes and would turn
    # the review identifier into a misleading promise of conflict detection.
    # Verify current device/GPT identity and isolation cheaply; arbitrary raw
    # writes after review remain an explicit, user-assessed window of risk.
    inventory = disk_inventory(config)
    firmware_boot = firmware_boot_snapshot(config, inventory)
    current_disk = {**inventory["identity"], "size_bytes": inventory["size_bytes"],
                    "logical_sector_size": inventory["sector_size"],
                    "size_lba": inventory["size_lba"]}
    if (current_disk != previous.get("disk")
            or inventory["partitions"] != previous.get("partitions")
            or config["partitions"] != previous.get("guard", {}).get(
                "configured_partitions")):
        fail("disk identity, GPT layout, or partition allowlist changed after review")
    previous_guard = previous.get("guard", {})
    if ("base_root_baseline_sha256" not in previous_guard
            or (not pending and base_baseline_digest(config)
                != previous_guard.get("base_root_baseline_sha256"))):
        fail("COW-root baseline record changed or is no longer in the reviewed state")
    if pending and phase == "firmware-guarding":
        # No physical merge has started in this phase. A power loss may have
        # occurred before UEFI was fully redirected to Linux, so Windows could
        # have booted natively and changed the base before recovery began.
        if previous_guard.get("base_root_baseline_status") == "verified":
            verify_root_baseline(config, inventory)
        reviewed_base_sha256 = previous_guard.get("base_precommit_sha256")
        if (not reviewed_base_sha256 or base_content_fingerprint(
                config["disk"], base_fingerprint_extents(config, inventory))
                != reviewed_base_sha256):
            fail("backing sectors changed before the physical merge began; "
                 "manual reconciliation is required")
    if not pending and firmware_boot != previous.get("firmware_boot"):
        fail("UEFI boot order or native-Windows boot entries changed after review")
    verify_no_block_device_users(config, devices)
    if (not pending or phase in ("merge-pending", "merge-interrupted")) and \
            overlay_fingerprint(config) != previous.get("overlay"):
        fail("overlay metadata changed after review; review again")
    if progress:
        print("Guarded COW save: recording a durable write-pending state.",
              file=sys.stderr, flush=True)

    # The token represents a user-reviewed plan. The GUI calls this action
    # only after its separate explicit commit confirmation.
    if not pending:
        state["save_pending"] = True
        state["save_transaction"] = {
            "review_id": token,
            "review_created_at": previous["created_at"],
            "review_expires_at": previous["expires_at"],
            "disk": current_disk,
            "overlay": previous["overlay"],
            "partition_allowlist": config["partitions"],
            "plan_sha256": previous["guard"]["plan_sha256"],
            "planned_extents": previous["planned_extents"],
            "firmware_boot": previous.get("firmware_boot"),
            "review_report": previous,
            "phase": ("firmware-guarding" if previous.get("firmware_boot")
                      else "merge-pending"),
            "started_at": int(time.time()),
        }
    transaction = state["save_transaction"]

    def set_phase(phase):
        transaction["phase"] = phase
        write_state(state)

    phase = transaction.get("phase", "merge-pending")
    try:
        if phase == "firmware-guarding":
            apply_firmware_boot_guard(transaction.get("firmware_boot"))
            set_phase("merge-pending")
            phase = "merge-pending"
        if phase in ("merge-pending", "merge-interrupted"):
            set_phase("merge-pending")
            commit_overlay(config, progress=progress, phase_callback=set_phase)
        elif phase in ("merge-complete", "replacement-pending",
                       "replacement-interrupted"):
            set_phase("replacement-pending")
            replace_overlay(config, progress=progress)
            set_phase("replacement-complete")
        elif phase == "replacement-complete":
            validate_overlay(config)
        else:
            fail(f"unknown guarded COW recovery phase {phase!r}; manual reconciliation is required")
    except Exception as exc:
        current_phase = transaction.get("phase")
        if current_phase in ("merge-pending", "merge-interrupted"):
            transaction["phase"] = "merge-interrupted"
        elif current_phase in ("replacement-pending", "replacement-interrupted"):
            transaction["phase"] = "replacement-interrupted"
        state["save_transaction"]["last_error"] = str(exc)
        write_state(state)
        raise
    state["save_complete"] = True
    write_state(state)
    if progress:
        print("Guarded COW save: physical merge complete; restoring host mount state.",
              file=sys.stderr, flush=True)
    restore(domain)
    review_path.unlink(missing_ok=True)
    if progress:
        print("Guarded COW save: complete.", file=sys.stderr, flush=True)


def prepare(config):
    if read_journal(config["domain"]) is not None:
        fail("durable guarded COW save journal needs reconciliation before VM start")
    if STATE.exists():
        try:
            state = json.loads(STATE.read_text(encoding="utf-8"))
        except Exception as exc:
            fail(f"cannot read existing guarded COW state: {exc}")
        if (state.get("domain") != config["domain"]
                or state.get("disk") != config["disk"]
                or state.get("partitions") != config["partitions"]):
            fail("another guarded COW VM or maintenance action holds the physical-disk lock")
        if state.get("save_pending") and not state.get("save_complete"):
            fail("a guarded COW save is incomplete; finish it before restarting the VM")
        devices = part_devices(config)
        verify_no_allowed_swap(devices)
        for part in config["partitions"]:
            rows = mounts_for(devices, part["number"])
            expected = part["mountpoint"]
            if len(rows) > 1 or (rows and (not expected or rows[0]["target"] != expected)):
                for row in rows:
                    if is_rw(row):
                        remount_readonly(row)
                fail(f"configured partition {part['number']} has an unexpected or multiply-mounted host mount")
            for row in rows:
                if is_rw(row):
                    remount_readonly(row)
                run("umount", "--", row["target"])
            if mounts_for(devices, part["number"]):
                fail(f"partition {part['number']} remained mounted after isolation")
        uid = pwd.getpwnam(HELPER_USER).pw_uid
        run("setfacl", "-m", f"u:{uid}:r--", config["disk"])
        verify_qemu_readonly(config["disk"])
        state["guest_active"] = False
        write_state(state)
        return
    devices = part_devices(config)
    verify_no_allowed_swap(devices)
    mounts = []
    for part in config["partitions"]:
        rows = mounts_for(devices, part["number"])
        expected = part["mountpoint"]
        if len(rows) > 1 or (rows and (not expected or rows[0]["target"] != expected)):
            for row in rows:
                if is_rw(row):
                    remount_readonly(row)
            fail(f"configured partition {part['number']} has an unexpected or multiply-mounted host mount")
        if rows:
            row = rows[0]
            if not (is_rw(row) or is_ro(row)):
                fail(f"cannot determine host mount mode for partition {part['number']}")
            mounts.append({"number": part["number"], "target": row["target"],
                           "mode": "rw" if is_rw(row) else "ro"})
    state = {"domain": config["domain"], "disk": config["disk"],
             "partitions": config["partitions"], "mounts": mounts,
             "disk_acl": disk_acl(config["disk"])}
    write_state(state)
    try:
        for mount in mounts:
            row = next(row for row in mounts_for(devices, mount["number"])
                       if row["target"] == mount["target"])
            if is_rw(row):
                remount_readonly(row)
            run("umount", "--", mount["target"])
        for part in config["partitions"]:
            if mounts_for(devices, part["number"]):
                fail(f"partition {part['number']} remained mounted after isolation")
        uid = pwd.getpwnam(HELPER_USER).pw_uid
        run("setfacl", "-m", f"u:{uid}:r--", config["disk"])
        verify_qemu_readonly(config["disk"])
    except Exception:
        # Keep the lock and the recorded prior mount state. No guest has
        # started yet, but automatic restoration could expose a writable
        # partition while this setup is being recovered.
        raise


def restore(domain):
    state = read_journal(domain)
    if state is None and STATE.exists():
        try:
            state = json.loads(STATE.read_text(encoding="utf-8"))
        except Exception as exc:
            fail(f"cannot read guarded COW state: {exc}")
    if state is None:
        return
    if state.get("domain") != domain:
        fail("release hook domain does not match the guarded COW state")
    if state.get("save_pending") and not state.get("save_complete"):
        fail("a guarded COW save is incomplete; partitions remain isolated until the merge succeeds")
    if state.get("guest_active"):
        fail("cannot release guarded COW isolation while the guest is active")
    if not (state.get("save_complete") or state.get("discard_complete")):
        fail("cannot restore host write access until guarded COW changes are saved or discarded")
    config = {"disk": state["disk"], "partitions": state["partitions"]}
    devices = part_devices(config)
    saved_mounts = {mount["number"]: mount for mount in state["mounts"]}
    for part in config["partitions"]:
        rows = mounts_for(devices, part["number"])
        expected = saved_mounts.get(part["number"])
        if rows and (not expected or len(rows) != 1
                     or rows[0]["target"] != expected["target"]):
            fail(f"partition {part['number']} has an unexpected mount while guarded COW isolation was active")
        if rows and not (state.get("save_complete") or state.get("discard_complete")):
            fail(f"partition {part['number']} was mounted before guarded COW completion")
    try:
        for mount in state["mounts"]:
            rows = mounts_for(devices, mount["number"])
            if rows:
                if (mount["mode"] == "ro") != is_ro(rows[0]):
                    mode = "ro" if mount["mode"] == "ro" else "rw"
                    run("mount", "-o", f"remount,{mode}", "--", mount["target"])
            else:
                if mount["mode"] == "ro":
                    run("mount", "-o", "ro", "--", mount["target"])
                else:
                    run("mount", "--", mount["target"])
            rows = mounts_for(devices, mount["number"])
            if len(rows) != 1 or rows[0]["target"] != mount["target"]:
                fail(f"fresh mount for partition {mount['number']} did not resolve to {mount['target']}")
            if (mount["mode"] == "ro") != is_ro(rows[0]):
                run("umount", "--", mount["target"])
                fail(f"fresh mount for partition {mount['number']} did not recover its prior access mode")
    except Exception:
        # A partial mount restoration must not leave a writable host mount
        # while the isolation record still exists.
        for mount in state["mounts"]:
            for row in mounts_for(devices, mount["number"]):
                if is_rw(row):
                    remount_readonly(row)
        raise
    try:
        restore_disk_acl(state["disk"], state["disk_acl"])
    except Exception as exc:
        fail(f"host mount restoration completed, but disk ACL restoration failed: {exc}")
    if state.get("save_complete"):
        transaction = state.get("save_transaction", {})
        restore_firmware_boot(transaction.get("firmware_boot"))
    remove_journal(domain)
    STATE.unlink()


def guest_stopped(domain, reason):
    if not STATE.exists():
        return
    try:
        state = json.loads(STATE.read_text(encoding="utf-8"))
    except Exception as exc:
        fail(f"cannot read guarded COW state: {exc}")
    if state.get("domain") != domain:
        fail("release hook domain does not match the guarded COW state")
    state["guest_active"] = False
    state["last_shutdown_reason"] = reason
    state["snapshot_eligible"] = reason == "shutdown"
    write_state(state)


def guest_started(domain):
    if not STATE.exists():
        fail("started hook has no guarded COW isolation state")
    try:
        state = json.loads(STATE.read_text(encoding="utf-8"))
    except Exception as exc:
        fail(f"cannot read guarded COW state: {exc}")
    if state.get("domain") != domain:
        fail("started hook domain does not match the guarded COW state")
    state["guest_active"] = True
    state["last_shutdown_reason"] = None
    state["snapshot_eligible"] = False
    write_state(state)


def assert_vm_off(domain):
    try:
        state = run("virsh", "domstate", domain).stdout.strip().lower()
        if state != "shut off":
            fail(f"VM must be fully shut off before save/discard (current state: {state})")
        info = run("virsh", "dominfo", domain).stdout
        if not re.search(r"^Managed save:\s+no\s*$", info, re.MULTILINE):
            fail("VM has a managed-save state; clear it before save/discard")
    except (subprocess.CalledProcessError, OSError) as exc:
        # Permit explicit recovery from the early-boot fail-closed state,
        # before libvirt services and ordinary local mounts have started.
        qemu = []
        for proc in Path("/proc").iterdir():
            if not proc.name.isdecimal():
                continue
            try:
                comm = (proc / "comm").read_text(encoding="utf-8").strip()
                cmdline = (proc / "cmdline").read_bytes().replace(b"\0", b" ")
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
            if ("qemu" in comm.lower() and
                    re.search(rb"(?:^|[ =,])" + re.escape(domain.encode()) +
                              rb"(?:$|[, ])", cmdline)):
                qemu.append(f"{proc.name} ({comm})")
        if qemu:
            fail("cannot verify that the VM is off while libvirt is unavailable; "
                 "QEMU processes remain: " + ", ".join(qemu))
        save_state = Path("/var/lib/libvirt/qemu/save") / f"{domain}.save"
        if save_state.exists():
            fail("VM has a managed-save state; clear it before save/discard")
        if not Path("/etc/libvirt/qemu", f"{domain}.xml").is_file():
            fail(f"cannot verify VM state while libvirt is unavailable: {exc}")


def boot_check():
    try:
        directory_stat = os.lstat(JOURNAL_DIR)
    except FileNotFoundError:
        return
    if (not stat.S_ISDIR(directory_stat.st_mode)
            or directory_stat.st_uid != os.geteuid()
            or stat.S_IMODE(directory_stat.st_mode) != 0o700):
        fail(f"durable guarded COW journal directory is not private: {JOURNAL_DIR}")
    try:
        journals = sorted(JOURNAL_DIR.glob("*.json"))
    except OSError as exc:
        fail(f"cannot inspect durable guarded COW journals: {exc}")
    if journals:
        names = ", ".join(path.name for path in journals)
        fail("unreconciled guarded COW transaction journal(s) exist: " + names +
             "; affected partitions must remain unavailable until explicit recovery")


def replace_overlay(config, progress=False):
    sector_size = int(run("blockdev", "--getss", config["disk"]).stdout.strip())
    if sector_size < 512 or sector_size > 4096 or sector_size & (sector_size - 1):
        fail(f"unsupported logical sector size for guarded COW: {sector_size}")
    overlay_path = Path(config["overlay"])
    baseline_path = base_baseline_path(config)
    directory = overlay_path.parent
    fd, temp_path = tempfile.mkstemp(prefix=".guarded-cow-", suffix=".qcow2", dir=directory)
    os.close(fd)
    os.unlink(temp_path)
    baseline_temp = None
    overlay_backup = None
    baseline_backup = None
    overlay_saved = baseline_saved = False
    overlay_installed = baseline_installed = False
    try:
        run(QEMU_IMG, "create", "-q", "-f", "qcow2", "-F", "raw", "-b", config["disk"],
            "-o", f"cluster_size={sector_size},compat=1.1", temp_path)
        uid = pwd.getpwnam(HELPER_USER).pw_uid
        gid = pwd.getpwnam(HELPER_USER).pw_gid
        os.chown(temp_path, uid, gid)
        os.chmod(temp_path, 0o600)
        candidate = dict(config)
        candidate["overlay"] = temp_path
        validate_overlay(candidate)
        baseline = capture_base_baseline(
            config, progress=progress,
            progress_label="Capturing the new COW-root baseline")
        baseline_temp = stage_base_baseline(config, baseline)

        # Keep the previous overlay and its matching baseline recoverable
        # until both new files are installed, durable, and mutually checked.
        for prefix, target, flag in ((".guarded-cow-old-", overlay_path, "overlay"),
                                     (".pwg-base-old-", baseline_path, "baseline")):
            if target.exists():
                backup_fd, backup = tempfile.mkstemp(prefix=prefix, dir=directory)
                os.close(backup_fd)
                os.unlink(backup)
                if flag == "overlay":
                    overlay_backup = backup
                    os.replace(target, backup)
                    overlay_saved = True
                else:
                    baseline_backup = backup
                    os.replace(target, backup)
                    baseline_saved = True

        os.replace(temp_path, overlay_path)
        overlay_installed = True
        os.replace(baseline_temp, baseline_path)
        baseline_temp = None
        baseline_installed = True
        fsync_directory(directory)
        validate_overlay(config)
        if load_base_baseline(config) != baseline:
            fail("installed COW-root baseline differs from its staged record")
        verify_root_baseline(
            config, progress=progress,
            progress_label="Verifying the new COW-root baseline")
    except Exception as exc:
        try:
            if baseline_installed:
                baseline_path.unlink(missing_ok=True)
            if overlay_installed:
                overlay_path.unlink(missing_ok=True)
            if baseline_saved:
                os.replace(baseline_backup, baseline_path)
                baseline_saved = False
            if overlay_saved:
                os.replace(overlay_backup, overlay_path)
                overlay_saved = False
            fsync_directory(directory)
        except Exception as rollback_exc:
            raise GuardError(
                "COW overlay/baseline replacement failed and rollback was incomplete; "
                f"preserve recovery files {overlay_backup!r} and "
                f"{baseline_backup!r}: {rollback_exc}") from exc
        raise
    else:
        for backup in (overlay_backup if overlay_saved else None,
                       baseline_backup if baseline_saved else None):
            if backup:
                try:
                    os.unlink(backup)
                except OSError as exc:
                    print(f"qemu-guarded-cow: retained old recovery file {backup}: {exc}",
                          file=sys.stderr)
        fsync_directory(directory)
    finally:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass
        if baseline_temp:
            try:
                os.unlink(baseline_temp)
            except FileNotFoundError:
                pass


def commit_overlay(config, progress=False, phase_callback=None):
    args = [QEMU_IMG, "commit"]
    if progress:
        print("Guarded COW save: writing the reviewed extents to the physical disk.",
              file=sys.stderr, flush=True)
        args.append("-p")
    args.extend(("-d", "--image-opts", "--backing-image-opts",
                 guard_options(config), overlay_options(config)))
    if progress:
        # qemu-img prints its live percentage to stdout. Inherit the caller's
        # terminal for this opt-in CLI mode; normal GUI runs keep captured IO.
        subprocess.run(args, check=True, stdout=sys.stdout)
        print("Guarded COW save: replacing the committed overlay with a fresh root.",
              file=sys.stderr, flush=True)
    else:
        run(*args)
    if phase_callback:
        phase_callback("merge-complete")
        phase_callback("replacement-pending")
    replace_overlay(config, progress=progress)
    if phase_callback:
        phase_callback("replacement-complete")


def offline_action(domain, action):
    assert_vm_off(domain)
    config = parse_config(domain)
    validate_overlay(config)
    if action == "save":
        if STATE.exists():
            try:
                state = json.loads(STATE.read_text(encoding="utf-8"))
            except Exception as exc:
                fail(f"cannot read guarded COW state for save retry: {exc}")
            if (state.get("domain") != domain or state.get("disk") != config["disk"]
                    or state.get("partitions") != config["partitions"]
                    or state.get("guest_active")
                    or state.get("save_complete") or state.get("discard_complete")):
                fail("an unrelated guarded COW action already holds the physical-disk lock")
            if state.get("save_pending"):
                devices = part_devices(config)
                verify_no_allowed_swap(devices)
                for part in config["partitions"]:
                    rows = mounts_for(devices, part["number"])
                    if any(not is_ro(row) for row in rows):
                        fail("a configured partition became writable during an incomplete save; refusing to retry")
                    for row in rows:
                        run("umount", "--", row["target"])
                    if mounts_for(devices, part["number"]):
                        fail(f"partition {part['number']} remained mounted during save retry")
                verify_qemu_readonly(config["disk"])
            else:
                prepare(config)
                state = json.loads(STATE.read_text(encoding="utf-8"))
                state["save_pending"] = True
                write_state(state)
        else:
            prepare(config)
            state = json.loads(STATE.read_text(encoding="utf-8"))
            state["save_pending"] = True
            write_state(state)
        commit_overlay(config)
        state["save_complete"] = True
        write_state(state)
        restore(domain)
    else:
        prepare(config)
        replace_overlay(config)
        state = json.loads(STATE.read_text(encoding="utf-8"))
        state["discard_complete"] = True
        write_state(state)
        restore(domain)


def dispatch(action, domain, operation_argument=None, progress=False):
    if action == "boot-check":
        boot_check()
        return
    if action == "check-start":
        if JOURNAL_DIR.exists() and any(JOURNAL_DIR.glob("*.json")):
            fail("a durable guarded COW transaction needs reconciliation before VM start")
        if STATE.exists():
            held = json.loads(STATE.read_text(encoding="utf-8")).get("domain")
            if held != domain:
                fail(f"domain {held} has the physical disk isolated for guarded COW")
        return
    if action == "restore":
        restore(domain)
        return
    if action == "guest-stopped":
        guest_stopped(domain, operation_argument or "-")
        return
    if action == "guest-started":
        guest_started(domain)
        return
    xml_data = None
    if action in ("prepare", "verify") and not sys.stdin.isatty():
        xml_data = sys.stdin.read()
    config = parse_config(domain, xml_data)
    if action == "prepare":
        validate_overlay(config)
        prepare(config)
    elif action == "verify":
        if not STATE.exists() or json.loads(STATE.read_text(encoding="utf-8")).get("domain") != domain:
            fail("start hook has no matching prepared COW state")
        devices = part_devices(config)
        verify_no_allowed_swap(devices)
        verify_qemu_readonly(config["disk"])
        verify_partitions_not_writable(devices, config["partitions"])
    elif action == "initialize":
        assert_vm_off(domain)
        if os.path.exists(config["overlay"]):
            fail(f"refusing to overwrite existing overlay {config['overlay']}")
        if base_baseline_path(config).exists() or STATE.exists():
            fail("refusing to initialize over an existing COW baseline or isolation state")
        prepare(config)
        replace_overlay(config)
        state = json.loads(STATE.read_text(encoding="utf-8"))
        state["discard_complete"] = True
        write_state(state)
        restore(domain)
    elif action == "review":
        review_action(domain)
    elif action == "commit":
        commit_review(domain, operation_argument, progress=progress)
    elif action == "discard":
        offline_action(domain, action)
    else:
        fail("unknown action")


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) == 2 and sys.argv[1] == "boot-check":
        with operation_lock():
            boot_check()
        return
    if len(sys.argv) not in (3, 4, 5):
        fail("usage: qemu-guarded-cow prepare|verify|guest-started|restore|initialize|review|commit DOMAIN [REVIEW_ID [--progress]] | guest-stopped DOMAIN SHUTOFF_REASON | discard DOMAIN | check-start DOMAIN | boot-check")
    action, domain = sys.argv[1:3]
    progress = False
    if action == "commit":
        if len(sys.argv) not in (4, 5):
            fail("commit requires the review identifier")
        operation_argument = sys.argv[3]
        if len(sys.argv) == 5:
            if sys.argv[4] != "--progress":
                fail("commit's optional fifth argument must be --progress")
            progress = True
    elif action == "guest-stopped":
        if len(sys.argv) != 4:
            fail("guest-stopped requires libvirt's shutdown reason")
        operation_argument = sys.argv[3]
    else:
        if len(sys.argv) != 3:
            fail(f"{action} takes a domain name only")
        operation_argument = None
    if action == "check-start":
        dispatch(action, domain)
        return
    with operation_lock():
        dispatch(action, domain, operation_argument, progress=progress)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"qemu-guarded-cow: {exc}", file=sys.stderr)
        sys.exit(1)
