[Unit]
Description=Fail closed on an unreconciled guarded COW disk save
DefaultDependencies=no
After=systemd-remount-fs.service
Before=local-fs-pre.target
RequiresMountsFor=/var/lib/libvirt/qemu-guarded-cow
OnFailure=emergency.target
OnFailureJobMode=isolate

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/qemu-guarded-cow boot-check
RemainAfterExit=yes

[Install]
RequiredBy=local-fs-pre.target
