            'configured writable partitions and GPT metadata at review time')
        self.assertEqual(
            missing_baseline_report['guard']['base_precommit_sha256'],
            helper.base_content_fingerprint(
                image, helper.base_fingerprint_extents(config, _inventory)))
        offline_state = json.loads(helper.STATE.read_text(encoding='utf-8'))
        self.assertFalse(offline_state['guest_active'])
        self.assertEqual(offline_state['mounts'], [])
        baseline_path.write_bytes(saved_baseline)
        os.chmod(baseline_path, 0o600)
        helper.PHYSICAL_COMMIT_ENABLED = True

        review_output = io.StringIO()
        with contextlib.redirect_stdout(review_output):
            helper.review_action('disposable')
        report = json.loads(review_output.getvalue())
        self.assertFalse(report['physical_disk_written'])
        self.assertTrue(report['commit_enabled'])
        if report['helper']['installed']:
            self.assertTrue(report['helper']['source_match'])
            self.assertTrue(report['recovery_guard']['enabled'])
            self.assertTrue(report['recovery_guard']['active'])
            self.assertEqual(
                report['recovery_guard']['effective_properties']['UnitFileState'],
                'enabled')
        self.assertIn('base_root_capture_basis', report['guard'])
        self.assertEqual(report['shutdown'], {
            'reason': 'unknown', 'clean_snapshot_eligible': False,
        })
        self.assertIn('review ID is valid for one hour',
                      report['notice'])
        fingerprint_supported = 'base_content_sha256' in report['guard']
        if fingerprint_supported:
            self.assertEqual(report['guard']['base_content_coverage'],
                             'planned commit extents at review time')
            self.assertRegex(report['guard']['base_content_sha256'],
                             r'^[0-9a-f]{64}$')
            self.assertEqual(report['guard']['base_root_content_sha256'],
                             root_baseline['content_sha256'])
            self.assertEqual(report['guard']['base_root_content_coverage'],
                             'all configured writable GPT partitions and GPT metadata')
        self.assertTrue(report['planned_extents'])
        self.assertIn('<svg ', report['disk_map_svg'])
        self.assertIn('primary GPT entry array', report['disk_map_svg'])
        helper.PHYSICAL_COMMIT_ENABLED = False
        with self.assertRaisesRegex(helper.GuardError,
                                    'physical COW commit is disabled'):
            helper.commit_review('disposable', report['review_id'])
        helper.PHYSICAL_COMMIT_ENABLED = True
        with open(image, 'rb') as stream:
            self.assertEqual(stream.read(), base_before)

        # Exercise the reviewed save path only against this disposable image.
        # Simulate an ambiguous failure after qemu-img has completed its writes,
        # then verify that the retained overlay and pending state support retry.
        expected = bytearray(base_before)
        for number in (1, 3, 7):
            for lba in PARTITIONS[number]:
                offset = lba * sector_size
                expected[offset:offset + sector_size] = bytes([number]) * sector_size

        helper.PHYSICAL_COMMIT_ENABLED = True
        review_output = io.StringIO()
        with contextlib.redirect_stdout(review_output):
            helper.review_action('disposable')
        commit_report = json.loads(review_output.getvalue())
        self.assertTrue(commit_report['commit_enabled'])
        self.assertIn('base_root_capture_basis', commit_report['guard'])
        self.assertIn('review ID is valid for one hour',
                      commit_report['notice'])
        _raw_recheck, extents_recheck, _inventory_recheck = helper.make_write_plan(config)
        self.assertEqual(extents_recheck, commit_report['planned_extents'])
        self.assertEqual(helper.write_plan_sha256(extents_recheck),
                         commit_report['guard']['plan_sha256'])

        original_make_write_plan = helper.make_write_plan
        commit_plan_calls = 0

        def count_commit_write_plan(config, progress=False):
            nonlocal commit_plan_calls
            commit_plan_calls += 1
            return original_make_write_plan(config, progress=progress)

        helper.make_write_plan = count_commit_write_plan

        # A recent review is the user's authorization; do not spend minutes
        # repeating its full-base content scan after the write phase begins.
        changed_offset = untouched_allowed_offset
        change_base_once = fingerprint_supported
        old_overlay_stat = os.stat(overlay)
        fail_after_commit = True
        restore_calls = []
        qemu_commit_calls = 0

        def finish_restore(domain):
            restore_calls.append(domain)
            transaction_state = helper.read_journal(domain)
            helper.restore_firmware_boot(
                transaction_state['save_transaction']['firmware_boot'])
            helper.remove_journal(domain)
            helper.STATE.unlink(missing_ok=True)

        helper.restore = finish_restore
        original_replace_overlay = helper.replace_overlay

        def fail_once_after_commit(*args, input=None):
            nonlocal fail_after_commit, qemu_commit_calls, change_base_once
            if args[0] == 'blockdev' and args[1] == '--getss':
                return subprocess.CompletedProcess(args, 0, '512\n', '')
            if (args[0] == helper.QEMU_IMG and 'commit' in args
                    and change_base_once):
                with open(image, 'r+b') as stream:
                    stream.seek(changed_offset)
                    original_byte = stream.read(1)
                    stream.seek(changed_offset)
                    stream.write(bytes([original_byte[0] ^ 0xff]))
                expected[changed_offset] ^= 0xff
                change_base_once = False
                helper.disk_metadata_matches = original_metadata_matches
            result = run_with_disposable_geometry(*args, input=input)
            if args[0] == helper.QEMU_IMG and 'commit' in args:
                qemu_commit_calls += 1
                if fail_after_commit:
                    fail_after_commit = False
                    raise subprocess.CalledProcessError(
                        1, args, output=result.stdout,
                        stderr='injected failure after disposable-disk commit')
            return result

        helper.run = fail_once_after_commit
        original_metadata_matches = helper.disk_metadata_matches
        old_time = helper.time.time
        try:
            original_apply_firmware_boot_guard = helper.apply_firmware_boot_guard

            def interrupt_before_merge(snapshot):
                original_apply_firmware_boot_guard(snapshot)
                raise RuntimeError('injected interruption before physical merge')

            helper.apply_firmware_boot_guard = interrupt_before_merge
            with self.assertRaisesRegex(RuntimeError,
                                        'injected interruption before physical merge'):
                helper.commit_review('disposable', commit_report['review_id'])
            helper.apply_firmware_boot_guard = original_apply_firmware_boot_guard
            prewrite_state = json.loads(helper.journal_path(
                'disposable').read_text(encoding='utf-8'))
            self.assertEqual(prewrite_state['save_transaction']['phase'],
                             'firmware-guarding')
            self.assertEqual(qemu_commit_calls, 0)

            # The merge has not started, so a native boot after a crash in
            # firmware-guarding must be detected from the base content before
            # a retry can begin writing.
            helper.disk_metadata_matches = lambda _baseline, _current: True
            with open(image, 'r+b') as stream:
                stream.seek(untouched_allowed_offset)
                base_byte = stream.read(1)
                stream.seek(untouched_allowed_offset)
                stream.write(bytes([base_byte[0] ^ 0xff]))
            try:
                with self.assertRaisesRegex(helper.GuardError,
                                            'backing disk differs from its COW-root baseline'):
                    helper.commit_review('disposable', commit_report['review_id'])
                self.assertEqual(qemu_commit_calls, 0)
            finally:
                with open(image, 'r+b') as stream:
                    stream.seek(untouched_allowed_offset)
                    stream.write(base_byte)

            calls_before = commit_plan_calls
            with self.assertRaises(subprocess.CalledProcessError):
                helper.commit_review('disposable', commit_report['review_id'])
            self.assertEqual(commit_plan_calls - calls_before, 0)
            failed_state = json.loads(helper.STATE.read_text(encoding='utf-8'))
            self.assertTrue(failed_state['save_pending'])
            self.assertNotIn('save_complete', failed_state)
            self.assertEqual(os.stat(overlay).st_ino, old_overlay_stat.st_ino)
            self.assertEqual(restore_calls, [])
            self.assertEqual(efi_state['order'], ['0002'])
            self.assertFalse(efi_state['active']['0000'])
            with open(image, 'rb') as stream:
                self.assertEqual(stream.read(), expected)

            # Simulate loss of volatile /run state and the review cache. The
            # durable transaction must block startup and authorize a retry
            # after its original one-hour window.
            review_path = helper.REVIEW_DIR / (
                helper.hashlib.sha256(
                    commit_report['review_id'].encode()).hexdigest() + '.json')
            review_path.unlink()
            helper.STATE.unlink()
            with self.assertRaisesRegex(helper.GuardError,
                                        'unreconciled guarded COW transaction'):
                helper.boot_check()
            helper.time.time = lambda: commit_report['expires_at'] + 1

            # During a real reboot recovery, the early-boot unit has failed
            # into emergency.target and its source checkout may not be mounted.
            # The durable review must still authorize retry with the exact
            # installed helper and the same fail-closed unit configuration.
            pending_guard = dict(commit_report['recovery_guard'], active=False)
            helper.recovery_guard_identity = lambda require_active=True: (
                self.fail('pending retry incorrectly requires an active guard unit')
                if require_active else pending_guard)
            if source_path is not None:
                Path.read_bytes = hide_helper_source

            # Simulate process death after the fresh overlay has replaced the
            # committed overlay but before the replacement-complete phase is
            # journaled. Recovery must finish replacement without merging a
            # third time.
            def replace_then_interrupt(config, progress=False):
                original_replace_overlay(config, progress=progress)
                raise SystemExit('injected interruption after overlay replacement')

            helper.replace_overlay = replace_then_interrupt
            with self.assertRaisesRegex(SystemExit, 'injected interruption'):
                helper.commit_review('disposable', commit_report['review_id'])
            helper.replace_overlay = original_replace_overlay
            self.assertEqual(qemu_commit_calls, 2)
            interrupted_state = json.loads(
                helper.journal_path('disposable').read_text(encoding='utf-8'))
            self.assertEqual(interrupted_state['save_transaction']['phase'],
                             'replacement-pending')
            helper.STATE.unlink()
            with self.assertRaisesRegex(helper.GuardError,
                                        'unreconciled guarded COW transaction'):
                helper.boot_check()

            calls_before = commit_plan_calls
            progress_path = os.path.join(iotests.test_dir,
                                         'guarded-commit-progress.txt')
            with open(progress_path, 'w') as progress_stream:
                with contextlib.redirect_stdout(progress_stream), \
                        contextlib.redirect_stderr(progress_stream):
                    helper.commit_review('disposable',
                                         commit_report['review_id'],
                                         progress=True)
            helper.time.time = old_time
            with open(progress_path, 'r') as progress_stream:
                progress_text = progress_stream.read()
            self.assertNotIn('fresh guarded dry-run', progress_text)
            self.assertIn('checking disk identity, overlay metadata, and host isolation',
                          progress_text)
            self.assertNotIn('writing the reviewed extents to the physical disk',
                             progress_text)
            self.assertIn('Guarded COW save: complete.', progress_text)
            self.assertEqual(commit_plan_calls - calls_before, 0)
            self.assertEqual(qemu_commit_calls, 2)
            helper.boot_check()
            self.assertFalse(helper.STATE.exists())
            self.assertFalse(helper.journal_path('disposable').exists())
            self.assertEqual(restore_calls, ['disposable'])
            self.assertEqual(efi_state['order'], ['0000', '0002', '2001'])
            self.assertTrue(efi_state['active']['0000'])
            self.assertNotEqual(os.stat(overlay).st_ino, old_overlay_stat.st_ino)
            self.assertEqual(original_run(
                helper.QEMU_IMG, 'check', '-q', overlay).returncode, 0)
            new_info = json.loads(original_run(
                helper.QEMU_IMG, 'info', '--output=json', overlay).stdout)
            self.assertEqual(new_info['format'], 'qcow2')
            self.assertEqual(new_info['backing-filename'], image)
            self.assertEqual(new_info['backing-filename-format'], 'raw')
            self.assertEqual(new_info['virtual-size'], len(base_before))
            with open(image, 'rb') as stream:
                self.assertEqual(stream.read(), expected)
        finally:
            helper.run = original_run
            helper.firmware_boot_snapshot = original_firmware_boot_snapshot
            helper.HELPER_SOURCE_MANIFEST = original_helper_source_manifest
            helper.recovery_guard_identity = original_recovery_guard_identity
            Path.read_bytes = original_path_read_bytes
            helper.make_write_plan = original_make_write_plan
            helper.replace_overlay = original_replace_overlay
            helper.time.time = old_time
            helper.disk_metadata_matches = original_metadata_matches
            helper.pwd.getpwnam = original_getpwnam
            helper.PHYSICAL_COMMIT_ENABLED = False

    def test_guarded_cow_and_commit_4k_sectors(self) -> None:
        sector_size = 4096
        image_size = 1024 * sector_size
        image = os.path.join(iotests.test_dir, 'disk-4k.img')
        overlay = image + '.qcow2'
        make_gpt(image, sector_size, image_size)
        with open(image, 'rb') as stream:
            base_before = stream.read()
        qemu_img('create', '-q', '-f', 'qcow2',
                 '-o', f'cluster_size={sector_size}', overlay,
                 str(image_size))

        guarded_overlay = ','.join([
            'driver=partition-write-guard',
            'file.driver=qcow2',
            'file.file.driver=file',
            f'file.file.filename={overlay}',
            'file.backing.driver=blkdebug',
            f'file.backing.align={sector_size}',
            'file.backing.image.driver=file',
            f'file.backing.image.filename={image}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        expected = bytearray(base_before)
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for lba, pattern in ((first, number), (last, number + 0x10)):
                offset = lba * sector_size
                result = qemu_io(
                    '--image-opts', guarded_overlay, '-c',
                    f'write -P 0x{pattern:02x} {offset} {sector_size}',
                    check=False,
                )
                self.assertEqual(result.returncode, 0, result.stdout)
                expected[offset:offset + sector_size] = bytes([pattern]) * sector_size

        guarded_backing = ','.join([
            'driver=partition-write-guard',
            'file.driver=blkdebug',
            f'file.align={sector_size}',
            'file.image.driver=file',
            f'file.image.filename={image}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        top_image_opts = ','.join([
            'driver=qcow2',
            'file.driver=file',
            f'file.filename={overlay}',
        ])
        plan = os.path.join(iotests.test_dir, 'dry-run-plan-4k.jsonl')
        if os.path.exists(plan):
            os.unlink(plan)
        planned_backing = ','.join([
            guarded_backing,
            f'plan-file={plan}',
        ])
        result = qemu_img('commit', '-d', '--image-opts',
                          '--backing-image-opts', planned_backing,
                          top_image_opts, check=False)
        self.assertEqual(result.returncode, 0,
                         (result.stdout or '') + (result.stderr or ''))
        with open(image, 'rb') as stream:
            self.assertEqual(stream.read(), base_before)
        with open(plan, encoding='utf-8') as stream:
            events = [json.loads(line) for line in stream]
        self.assertEqual(events[-1], {
            'type': 'flush', 'event_count': len(events) - 2,
        })
        ranges = [(first * sector_size, (last + 1) * sector_size)
                  for number in (1, 3, 7)
                  for first, last in (PARTITIONS[number],)]
        self.assertTrue(events[1:-1])
        for event in events[1:-1]:
            self.assertEqual(event['type'], 'write')
            start, end = event['offset'], event['offset'] + event['length']
            self.assertTrue(any(start >= lo and end <= hi
                                for lo, hi in ranges), event)

        result = qemu_img('commit', '-d', '--image-opts',
                          '--backing-image-opts', guarded_backing,
                          top_image_opts, check=False)
        self.assertEqual(result.returncode, 0,
                         (result.stdout or '') + (result.stderr or ''))
        with open(image, 'rb') as stream:
            self.assertEqual(stream.read(), expected)


