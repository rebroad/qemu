import json
import os
import struct
import subprocess
import zlib

import iotests
from iotests import qemu_img, qemu_io


SECTOR_SIZE = 512
IMAGE_SIZE = 1024 * 1024
ENTRY_COUNT = 300
ENTRY_SIZE = 128
PARTITIONS = {
    1: (128, 255),
    2: (256, 383),
    3: (384, 511),
    7: (512, 639),
    256: (640, 767),
}


def make_gpt(path: str, sector_size: int = SECTOR_SIZE,
             image_size: int = IMAGE_SIZE) -> None:
    with open(path, 'wb') as image:
        image.truncate(image_size)

    entries = bytearray(ENTRY_COUNT * ENTRY_SIZE)
    type_guid = bytes.fromhex('28732ac11ff8d211ba4b00a0c93ec93b')
    for number, (first, last) in PARTITIONS.items():
        offset = (number - 1) * ENTRY_SIZE
        entries[offset:offset + 16] = type_guid
        entries[offset + 16:offset + 32] = number.to_bytes(16, 'little')
        struct.pack_into('<QQQ', entries, offset + 32, first, last, 0)

    table_lba = 2
    table_sectors = (len(entries) + sector_size - 1) // sector_size
    first_usable = table_lba + table_sectors + 1
    last_usable = image_size // sector_size - 2
    header = bytearray(sector_size)
    header[:8] = b'EFI PART'
    struct.pack_into('<IIIIQQQQ16sQIII', header, 8,
                     0x00010000, 92, 0, 0, 1,
                     image_size // sector_size - 1, first_usable,
                     last_usable, b'partition-guard', table_lba,
                     ENTRY_COUNT, ENTRY_SIZE, zlib.crc32(entries))
    struct.pack_into('<I', header, 16, zlib.crc32(header[:92]))

    with open(path, 'r+b') as image:
        image.seek(sector_size)
        image.write(header)
        image.seek(table_lba * sector_size)
        image.write(entries)


class TestPartitionWriteGuard(iotests.QMPTestCase):
    def setUp(self) -> None:
        self.test_img = os.path.join(iotests.test_dir, 'disk.img')
        make_gpt(self.test_img)
        with open(self.test_img, 'rb') as image:
            self.base_before = image.read()
        self.image_opts = ','.join([
            'driver=partition-write-guard',
            'file.driver=file',
            f'file.filename={self.test_img}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
            'partitions.3=256',
        ])

    def write(self, offset: int, command: str = 'write'):
        return qemu_io('--image-opts', self.image_opts,
                       '-c', f'{command} {offset} {SECTOR_SIZE}',
                       check=False)

    def test_allowed_and_denied_ranges(self) -> None:
        for number in (1, 3, 7, 256):
            offset = PARTITIONS[number][0] * SECTOR_SIZE
            result = qemu_io('--image-opts', self.image_opts,
                             '-c', f'write -P 0xab {offset} {SECTOR_SIZE}',
                             check=False)
            self.assertEqual(result.returncode, 0, result.stdout)

        offset = PARTITIONS[2][0] * SECTOR_SIZE
        for command in ('write', 'write -z', 'discard'):
            result = self.write(offset, command)
            self.assertNotEqual(result.returncode, 0, result.stdout)

        for offset in (0, SECTOR_SIZE, 2 * SECTOR_SIZE, 900 * SECTOR_SIZE):
            result = self.write(offset)
            self.assertNotEqual(result.returncode, 0, result.stdout)

        offset = PARTITIONS[1][1] * SECTOR_SIZE
        result = qemu_io('--image-opts', self.image_opts,
                         '-c', f'write -P 0xab {offset} {2 * SECTOR_SIZE}',
                         check=False)
        self.assertNotEqual(result.returncode, 0, result.stdout)

        with open(self.test_img, 'rb') as image:
            for number in (1, 3, 7, 256):
                image.seek(PARTITIONS[number][0] * SECTOR_SIZE)
                self.assertEqual(image.read(SECTOR_SIZE), bytes([0xab]) * SECTOR_SIZE)
            image.seek(PARTITIONS[2][0] * SECTOR_SIZE)
            self.assertEqual(image.read(SECTOR_SIZE), bytes(SECTOR_SIZE))
            image.seek(PARTITIONS[1][1] * SECTOR_SIZE)
            self.assertEqual(image.read(SECTOR_SIZE), bytes(SECTOR_SIZE))

    def test_qapi_integer_partition_numbers(self) -> None:
        file_node = json.dumps({
            'driver': 'file',
            'filename': self.test_img,
            'node-name': 'base',
        })
        guard_node = json.dumps({
            'driver': 'partition-write-guard',
            'file': 'base',
            'partitions': [256],
            'node-name': 'guard',
        })
        result = subprocess.run(
            [iotests.qemu_prog, '-nodefaults', '-machine', 'none',
             '-display', 'none', '-monitor', 'stdio',
             '-blockdev', file_node, '-blockdev', guard_node],
            input='quit\n', capture_output=True, text=True, timeout=10,
            check=False,
        )
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)

    def test_guarded_cow_and_commit(self) -> None:
        overlay = self.test_img + '.qcow2'
        qemu_img('create', '-q', '-f', 'qcow2', '-F', 'raw',
                 '-o', 'cluster_size=512', '-b', self.test_img, overlay)

        guarded_overlay = ','.join([
            'driver=partition-write-guard',
            'file.driver=qcow2',
            'file.file.driver=file',
            f'file.file.filename={overlay}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for offset, pattern in ((first * SECTOR_SIZE, number),
                                    (last * SECTOR_SIZE, number + 0x10)):
                allowed = qemu_io('--image-opts', guarded_overlay,
                                  '-c', f'write -P 0x{pattern:02x} {offset} {SECTOR_SIZE}',
                                  check=False)
                self.assertEqual(allowed.returncode, 0, allowed.stdout)

        denied_offset = PARTITIONS[2][0] * SECTOR_SIZE
        denied = qemu_io('--image-opts', guarded_overlay,
                         '-c', f'write -P 0x33 {denied_offset} {SECTOR_SIZE}',
                         check=False)
        self.assertNotEqual(denied.returncode, 0, denied.stdout)

        guarded_backing = ','.join([
            'driver=partition-write-guard',
            'file.driver=file',
            f'file.filename={self.test_img}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        top_image_opts = ','.join([
            'driver=qcow2',
            'file.driver=file',
            f'file.filename={overlay}',
        ])
        qemu_img('commit', '-d', '--image-opts', '--backing-image-opts',
                 guarded_backing, top_image_opts)

        expected = bytearray(self.base_before)
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for offset, pattern in ((first * SECTOR_SIZE, number),
                                    (last * SECTOR_SIZE, number + 0x10)):
                expected[offset:offset + SECTOR_SIZE] = bytes([pattern]) * SECTOR_SIZE
        with open(self.test_img, 'rb') as image:
            self.assertEqual(image.read(), expected)
        qemu_img('check', '-q', overlay)
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for offset, pattern in ((first * SECTOR_SIZE, number),
                                    (last * SECTOR_SIZE, number + 0x10)):
                retained = qemu_io('-f', 'qcow2', overlay, '-c',
                                   f'read -P 0x{pattern:02x} {offset} {SECTOR_SIZE}',
                                   check=False)
                self.assertEqual(retained.returncode, 0, retained.stdout)

    def test_guarded_commit_rejects_off_allowlist_extent(self) -> None:
        overlay = self.test_img + '.qcow2'
        qemu_img('create', '-q', '-f', 'qcow2', '-F', 'raw',
                 '-o', 'cluster_size=512', '-b', self.test_img, overlay)
        denied_offset = PARTITIONS[2][0] * SECTOR_SIZE
        qemu_io('-f', 'qcow2', overlay, '-c',
                f'write -P 0xcd {denied_offset} {SECTOR_SIZE}')

        guarded_backing = ','.join([
            'driver=partition-write-guard',
            'file.driver=file',
            f'file.filename={self.test_img}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        top_image_opts = ','.join([
            'driver=qcow2',
            'file.driver=file',
            f'file.filename={overlay}',
        ])
        result = qemu_img('commit', '-d', '--image-opts', '--backing-image-opts',
                          guarded_backing, top_image_opts, check=False)
        self.assertNotEqual(result.returncode, 0,
                            (result.stdout or '') + (result.stderr or ''))
        with open(self.test_img, 'rb') as image:
            self.assertEqual(image.read(), self.base_before)
        retained = qemu_io('-f', 'qcow2', overlay, '-c',
                           f'read -P 0xcd {denied_offset} {SECTOR_SIZE}',
                           check=False)
        self.assertEqual(retained.returncode, 0, retained.stdout)

    def test_guarded_cow_and_commit_4k_sectors(self) -> None:
        sector_size = 4096
        image_size = 1024 * sector_size
        image = os.path.join(iotests.test_dir, 'disk-4k.img')
        overlay = image + '.qcow2'
        make_gpt(image, sector_size, image_size)
        with open(image, 'rb') as stream:
            base_before = stream.read()
        qemu_img('create', '-q', '-f', 'qcow2',
                 '-o', f'cluster_size={sector_size}', overlay,
                 str(image_size))

        guarded_overlay = ','.join([
            'driver=partition-write-guard',
            'file.driver=qcow2',
            'file.file.driver=file',
            f'file.file.filename={overlay}',
            'file.backing.driver=blkdebug',
            f'file.backing.align={sector_size}',
            'file.backing.image.driver=file',
            f'file.backing.image.filename={image}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        expected = bytearray(base_before)
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for lba, pattern in ((first, number), (last, number + 0x10)):
                offset = lba * sector_size
                result = qemu_io(
                    '--image-opts', guarded_overlay, '-c',
                    f'write -P 0x{pattern:02x} {offset} {sector_size}',
                    check=False,
                )
                self.assertEqual(result.returncode, 0, result.stdout)
                expected[offset:offset + sector_size] = bytes([pattern]) * sector_size

        guarded_backing = ','.join([
            'driver=partition-write-guard',
            'file.driver=blkdebug',
            f'file.align={sector_size}',
            'file.image.driver=file',
            f'file.image.filename={image}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        top_image_opts = ','.join([
            'driver=qcow2',
            'file.driver=file',
            f'file.filename={overlay}',
        ])
        result = qemu_img('commit', '-d', '--image-opts',
                          '--backing-image-opts', guarded_backing,
                          top_image_opts, check=False)
        self.assertEqual(result.returncode, 0,
                         (result.stdout or '') + (result.stderr or ''))
        with open(image, 'rb') as stream:
            self.assertEqual(stream.read(), expected)


if __name__ == '__main__':
    iotests.main(supported_fmts=['raw'], supported_protocols=['file'])
