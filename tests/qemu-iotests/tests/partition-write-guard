SECTOR_SIZE = 512
IMAGE_SIZE = 1024 * 1024
ENTRY_COUNT = 300
ENTRY_SIZE = 128
PARTITIONS = {
    1: (128, 255),
    2: (256, 383),
    3: (384, 511),
    7: (512, 639),
    256: (640, 767),
}


def make_gpt(path: str, sector_size: int = SECTOR_SIZE,
             image_size: int = IMAGE_SIZE) -> None:
    with open(path, 'wb') as image:
        image.truncate(image_size)

    entries = bytearray(ENTRY_COUNT * ENTRY_SIZE)
    type_guid = bytes.fromhex('28732ac11ff8d211ba4b00a0c93ec93b')
    for number, (first, last) in PARTITIONS.items():
        offset = (number - 1) * ENTRY_SIZE
        entries[offset:offset + 16] = type_guid
        entries[offset + 16:offset + 32] = number.to_bytes(16, 'little')
        struct.pack_into('<QQQ', entries, offset + 32, first, last, 0)

    table_lba = 2
    table_sectors = (len(entries) + sector_size - 1) // sector_size
    backup_lba = image_size // sector_size - 1
    backup_table_lba = backup_lba - table_sectors
    first_usable = table_lba + table_sectors
    last_usable = backup_table_lba - 1

    def make_header(current_lba: int, alternate_lba: int,
                    entries_lba: int) -> bytearray:
        header = bytearray(sector_size)
        header[:8] = b'EFI PART'
        struct.pack_into('<IIIIQQQQ16sQIII', header, 8,
                         0x00010000, 92, 0, 0, current_lba,
                         alternate_lba, first_usable, last_usable,
                         b'partition-guard', entries_lba, ENTRY_COUNT,
                         ENTRY_SIZE, zlib.crc32(entries))
        struct.pack_into('<I', header, 16, zlib.crc32(header[:92]))
        return header

    primary = make_header(1, backup_lba, table_lba)
    backup = make_header(backup_lba, 1, backup_table_lba)
    mbr = bytearray(sector_size)
    mbr[446 + 4] = 0xee
    struct.pack_into('<II', mbr, 446 + 8, 1,
                     min(image_size // sector_size - 1, 0xffffffff))
    mbr[510:512] = b'\x55\xaa'

    with open(path, 'r+b') as image:
        image.seek(0)
        image.write(mbr)
        image.seek(sector_size)
        image.write(primary)
        image.seek(table_lba * sector_size)
        image.write(entries)
        image.seek(backup_table_lba * sector_size)
        image.write(entries)
        image.seek(backup_lba * sector_size)
        image.write(backup)


class TestPartitionWriteGuard(iotests.QMPTestCase):
    def setUp(self) -> None:
        self.test_img = os.path.join(iotests.test_dir, 'disk.img')
        make_gpt(self.test_img)
        with open(self.test_img, 'rb') as image:
            self.base_before = image.read()
        self.image_opts = ','.join([
            'driver=partition-write-guard',
            'file.driver=file',
            f'file.filename={self.test_img}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
            'partitions.3=256',
        ])

    def test_shutdown_reason_controls_snapshot_eligibility(self) -> None:
        helper_path = Path(__file__).resolve().parents[3] / 'scripts/qemu-guarded-cow'
        loader = importlib.machinery.SourceFileLoader(
            'qemu_guarded_cow_shutdown_test', str(helper_path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        helper = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(helper)
        helper.RUN_DIR = Path(iotests.test_dir) / 'shutdown-reason-run'
        helper.RUN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        helper.STATE = helper.RUN_DIR / 'active.json'

        for reason, eligible in (('shutdown', True), ('destroyed', False),
                                 ('crashed', False), ('-', False)):
            helper.STATE.write_text(json.dumps({
                'domain': 'disposable', 'guest_active': True,
            }), encoding='utf-8')
            helper.guest_stopped('disposable', reason)
            state = json.loads(helper.STATE.read_text(encoding='utf-8'))
            self.assertFalse(state['guest_active'])
            self.assertEqual(state['last_shutdown_reason'], reason)
            self.assertEqual(state['snapshot_eligible'], eligible)

        helper.guest_started('disposable')
        state = json.loads(helper.STATE.read_text(encoding='utf-8'))
        self.assertTrue(state['guest_active'])
        self.assertIsNone(state['last_shutdown_reason'])
        self.assertFalse(state['snapshot_eligible'])

    def test_firmware_boot_guard_is_reversible_and_targets_the_disk_esp(self) -> None:
        helper_path = Path(__file__).resolve().parents[3] / 'scripts/qemu-guarded-cow'
        loader = importlib.machinery.SourceFileLoader(
            'qemu_guarded_cow_firmware_test', str(helper_path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        helper = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(helper)

        esp_guid = '0cffc624-2969-4e6c-981e-ebbbc1308966'
        other_guid = 'aa12c624-2969-4e6c-981e-ebbbc1308966'
        state = {'order': ['0000', '0002', '2001'],
                 'active': {'0000': True, '0002': True, '0004': True}}

        def efibootmgr_output():
            order = ','.join(state['order'])
            rows = [f'BootOrder: {order}']
            for ident, name, guid, path in (
                    ('0000', 'Windows Boot Manager', esp_guid,
                    r'\EFI\Microsoft\Boot\bootmgfw.efi'),
                    ('0002', 'debian', esp_guid,
                    r'\EFI\debian\shimx64.efi'),
                    ('0004', 'Windows Boot Manager', other_guid,
                    r'\EFI\Microsoft\Boot\bootmgfw.efi')):
                marker = '*' if state['active'][ident] else ''
                rows.append(
                    f'Boot{ident}{marker} {name} '
                    f'HD(1,GPT,{guid},0x800,0x1000)/File({path})')
            return '\n'.join(rows) + '\n'

        original_run = helper.run

        def fake_run(*args, input=None):
            if args[0] != 'efibootmgr':
                return original_run(*args, input=input)
            if args[1] == '-o':
                state['order'] = args[2].split(',')
            elif args[1] == '-b':
                state['active'][args[2]] = args[3] == '-a'
            elif args[1] == '-O':
                state['order'] = []
            elif args[1] == '-v':
                return subprocess.CompletedProcess(
                    args, 0, efibootmgr_output(), '')
            else:
                self.fail(f'unexpected efibootmgr command: {args!r}')
            return subprocess.CompletedProcess(
                args, 0, efibootmgr_output(), '')

        helper.run = fake_run
        try:
            original = efibootmgr_output()
            snapshot = helper.parse_firmware_boot(original, [esp_guid])
            self.assertEqual(snapshot['linux_entry'], '0002')
            self.assertEqual(snapshot['windows_entries'], [
                {'id': '0000', 'active': True}])

            helper.apply_firmware_boot_guard(snapshot)
            self.assertEqual(state['order'], ['0002'])
            self.assertFalse(state['active']['0000'])
            self.assertTrue(state['active']['0004'])

            helper.restore_firmware_boot(snapshot)
            self.assertEqual(state['order'], ['0000', '0002', '2001'])
            self.assertTrue(state['active']['0000'])
            self.assertTrue(state['active']['0004'])

            empty_order_snapshot = dict(snapshot, boot_order=[])
            state['order'] = ['0002']
            helper.restore_firmware_boot(empty_order_snapshot)
            self.assertEqual(state['order'], [])

            off_disk_linux = original.replace(
                f'Boot0002* debian HD(1,GPT,{esp_guid}',
                f'Boot0002* debian HD(1,GPT,{other_guid}')
            with self.assertRaisesRegex(helper.GuardError,
                                        'cannot identify an active Linux EFI boot entry'):
                helper.parse_firmware_boot(off_disk_linux, [esp_guid])
        finally:
            helper.run = original_run

    def write(self, offset: int, command: str = 'write'):
        return qemu_io('--image-opts', self.image_opts,
                       '-c', f'{command} {offset} {SECTOR_SIZE}',
                       check=False)

    def test_allowed_and_denied_ranges(self) -> None:
        for number in (1, 3, 7, 256):
            offset = PARTITIONS[number][0] * SECTOR_SIZE
            result = qemu_io('--image-opts', self.image_opts,
                             '-c', f'write -P 0xab {offset} {SECTOR_SIZE}',
                             check=False)
            self.assertEqual(result.returncode, 0, result.stdout)

        offset = PARTITIONS[2][0] * SECTOR_SIZE
        for command in ('write', 'write -z', 'discard'):
            result = self.write(offset, command)
            self.assertNotEqual(result.returncode, 0, result.stdout)

        for offset in (0, SECTOR_SIZE, 2 * SECTOR_SIZE, 900 * SECTOR_SIZE):
            result = self.write(offset)
            self.assertNotEqual(result.returncode, 0, result.stdout)

        offset = PARTITIONS[1][1] * SECTOR_SIZE
        result = qemu_io('--image-opts', self.image_opts,
                         '-c', f'write -P 0xab {offset} {2 * SECTOR_SIZE}',
                         check=False)
        self.assertNotEqual(result.returncode, 0, result.stdout)

        with open(self.test_img, 'rb') as image:
            for number in (1, 3, 7, 256):
                image.seek(PARTITIONS[number][0] * SECTOR_SIZE)
                self.assertEqual(image.read(SECTOR_SIZE), bytes([0xab]) * SECTOR_SIZE)
            image.seek(PARTITIONS[2][0] * SECTOR_SIZE)
            self.assertEqual(image.read(SECTOR_SIZE), bytes(SECTOR_SIZE))
            image.seek(PARTITIONS[1][1] * SECTOR_SIZE)
            self.assertEqual(image.read(SECTOR_SIZE), bytes(SECTOR_SIZE))

