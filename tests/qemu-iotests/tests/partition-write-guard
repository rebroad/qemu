    def test_guarded_cow_and_commit(self) -> None:
        overlay = self.test_img + '.qcow2'
        qemu_img('create', '-q', '-f', 'qcow2', '-F', 'raw',
                 '-o', 'cluster_size=512', '-b', self.test_img, overlay)

        guarded_overlay = ','.join([
            'driver=partition-write-guard',
            'file.driver=qcow2',
            'file.file.driver=file',
            f'file.file.filename={overlay}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for offset, pattern in ((first * SECTOR_SIZE, number),
                                    (last * SECTOR_SIZE, number + 0x10)):
                allowed = qemu_io('--image-opts', guarded_overlay,
                                  '-c', f'write -P 0x{pattern:02x} {offset} {SECTOR_SIZE}',
                                  check=False)
                self.assertEqual(allowed.returncode, 0, allowed.stdout)

        denied_offset = PARTITIONS[2][0] * SECTOR_SIZE
        denied = qemu_io('--image-opts', guarded_overlay,
                         '-c', f'write -P 0x33 {denied_offset} {SECTOR_SIZE}',
                         check=False)
        self.assertNotEqual(denied.returncode, 0, denied.stdout)

        guarded_backing = ','.join([
            'driver=partition-write-guard',
            'file.driver=file',
            f'file.filename={self.test_img}',
            'partitions.0=1',
            'partitions.1=3',
            'partitions.2=7',
        ])
        top_image_opts = ','.join([
            'driver=qcow2',
            'file.driver=file',
            f'file.filename={overlay}',
        ])
        qemu_img('commit', '-d', '--image-opts', '--backing-image-opts',
                 guarded_backing, top_image_opts)

        expected = bytearray(self.base_before)
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for offset, pattern in ((first * SECTOR_SIZE, number),
                                    (last * SECTOR_SIZE, number + 0x10)):
                expected[offset:offset + SECTOR_SIZE] = bytes([pattern]) * SECTOR_SIZE
        with open(self.test_img, 'rb') as image:
            self.assertEqual(image.read(), expected)
        qemu_img('check', '-q', overlay)
        for number in (1, 3, 7):
            first, last = PARTITIONS[number]
            for offset, pattern in ((first * SECTOR_SIZE, number),
                                    (last * SECTOR_SIZE, number + 0x10)):
                retained = qemu_io('-f', 'qcow2', overlay, '-c',
                                   f'read -P 0x{pattern:02x} {offset} {SECTOR_SIZE}',
                                   check=False)
                self.assertEqual(retained.returncode, 0, retained.stdout)

    def test_live_commit_selected_layer_through_guard(self) -> None:
        layer_a = self.test_img + '.a.qcow2'
        layer_b = self.test_img + '.b.qcow2'
        layer_c = self.test_img + '.c.qcow2'
        for backing, overlay, backing_format in (
                (self.test_img, layer_a, 'raw'),
                (layer_a, layer_b, 'qcow2'),
                (layer_b, layer_c, 'qcow2')):
            qemu_img('create', '-q', '-f', 'qcow2', '-F', backing_format,
                     '-o', 'cluster_size=512', '-b', backing, overlay)

        allowed_start, allowed_end = PARTITIONS[1]
        allowed_offset = allowed_start * SECTOR_SIZE
        allowed_length = (allowed_end - allowed_start + 1) * SECTOR_SIZE
        qemu_io('-f', 'qcow2', layer_a, '-c',
                f'write -P 0xa1 {allowed_offset} {allowed_length}')
        b_offset = PARTITIONS[3][0] * SECTOR_SIZE
        c_offset = PARTITIONS[7][0] * SECTOR_SIZE
        qemu_io('-f', 'qcow2', layer_b, '-c',
                f'write -P 0xb3 {b_offset} {SECTOR_SIZE}')
        qemu_io('-f', 'qcow2', layer_c, '-c',
                f'write -P 0xc7 {c_offset} {SECTOR_SIZE}')

        with iotests.VM() as vm:
            vm.add_blockdev(f'file,node-name=base-file,read-only=on,'
                            f'filename={self.test_img}')
            vm.add_blockdev('partition-write-guard,node-name=guard-file,'
                            'file=base-file,partitions.0=1,partitions.1=3,'
                            'partitions.2=7')
            vm.add_blockdev('raw,node-name=guarded-base,file=guard-file')
            backing_node = 'guarded-base'
            for name, path in (('layer-a', layer_a),
                               ('layer-b', layer_b),
                               ('layer-c', layer_c)):
                vm.add_blockdev(vm.qmp_to_opts({
                    'driver': 'file', 'node-name': name + '-file',
                    'filename': path,
                }))
                vm.add_blockdev(vm.qmp_to_opts({
                    'driver': 'qcow2', 'node-name': name,
                    'file': name + '-file', 'backing': backing_node,
                }))
                backing_node = name
            vm.add_blockdev('partition-write-guard,node-name=active-guard,'
                            'file=layer-c,partitions.0=1,partitions.1=3,'
                            'partitions.2=7')
            vm.add_device('virtio-blk-pci,drive=active-guard,id=virtio0')
            vm.launch()

            # Match the host policy: QEMU sees the physical base read-only
            # while the guest runs, then is reopened writable only for the
            # guarded commit job.
            result = vm.qmp('blockdev-reopen', options=[{
                'driver': 'file', 'node-name': 'base-file',
                'filename': self.test_img, 'read-only': False,
            }])
            self.assertIn('return', result, result)
            job_id = 'commit-selected-b'
            result = vm.qmp('block-commit', device='active-guard',
                            **{'job-id': job_id, 'base-node': 'guarded-base',
                               'top-node': 'layer-b', 'speed': 1,
                               'backing-file': self.test_img,
                               'backing-mask-protocol': True})
            self.assertIn('return', result, result)
            vm.qmp('job-pause', id=job_id)
            deadline = time.monotonic() + 5.0
            while True:
                jobs = vm.qmp('query-jobs')['return']
                selected_job = next((job for job in jobs
                                     if job['id'] == job_id), None)
                if selected_job is None:
                    self.fail(f'commit job {job_id} ended before it could be paused')
                if selected_job['status'] == 'paused':
                    break
                if time.monotonic() >= deadline:
                    self.fail(f'commit job {job_id} did not pause: {selected_job}')
                time.sleep(0.01)

            # A write made after the selected intermediate snapshot boundary
            # must stay in the active descendant while its ancestors and the
            # selected layer are committed.
            live_pattern = 0xd1
            live_write = vm.hmp_qemu_io(
                'virtio0/virtio-backend',
                f'write -P 0x{live_pattern:02x} '
                f'{allowed_offset} {SECTOR_SIZE}', qdev=True)
            self.assertNotIn('Error', str(live_write), live_write)
            vm.qmp('block-job-set-speed', device=job_id, speed=0)
            vm.qmp('job-resume', id=job_id)
            vm.run_job(job_id, wait=60.0)

            named = vm.qmp('query-named-block-nodes')['return']
            names = {node.get('node-name') for node in named}
            self.assertIn('layer-b', names, names)
            self.assertIn('layer-c', names, names)
            result = vm.qmp('blockdev-reopen', options=[{
                'driver': 'file', 'node-name': 'base-file',
                'filename': self.test_img, 'read-only': True,
            }])
            self.assertIn('return', result, result)

        expected = bytearray(self.base_before)
        expected[allowed_offset:allowed_offset + allowed_length] = \
            bytes([0xa1]) * allowed_length
        expected[b_offset:b_offset + SECTOR_SIZE] = bytes([0xb3]) * SECTOR_SIZE
        with open(self.test_img, 'rb') as image:
            self.assertEqual(image.read(), expected)
        for path in (layer_b, layer_c):
            qemu_img('check', '-q', path)
        b_info = json.loads(qemu_img('info', '--output=json', layer_b).stdout)
        self.assertEqual(b_info.get('backing-filename'), layer_a)
        c_info = json.loads(qemu_img('info', '--output=json', layer_c).stdout)
        self.assertEqual(c_info.get('backing-filename'), self.test_img)
        for offset, pattern in ((allowed_offset, 0xd1),
                                (b_offset, 0xb3), (c_offset, 0xc7)):
            result = qemu_io('-f', 'qcow2', layer_c, '-c',
                             f'read -P 0x{pattern:02x} {offset} {SECTOR_SIZE}',
                             check=False)
            self.assertEqual(result.returncode, 0, result.stdout)

    def test_live_commit_rejects_off_allowlist_write(self) -> None:
        image = os.path.join(iotests.test_dir, 'live-denied.img')
        layer_a = image + '.a.qcow2'
        layer_b = image + '.b.qcow2'
        layer_c = image + '.c.qcow2'
        make_gpt(image)
        with open(image, 'rb') as stream:
            base_before = stream.read()
        qemu_img('create', '-q', '-f', 'qcow2', '-F', 'raw',
                 '-o', 'cluster_size=512', '-b', image, layer_a)
        qemu_img('create', '-q', '-f', 'qcow2', '-F', 'qcow2',
                 '-o', 'cluster_size=512', '-b', layer_a, layer_b)
        qemu_img('create', '-q', '-f', 'qcow2', '-F', 'qcow2',
                 '-o', 'cluster_size=512', '-b', layer_b, layer_c)
        denied_offset = PARTITIONS[2][0] * SECTOR_SIZE
        qemu_io('-f', 'qcow2', layer_a, '-c',
                f'write -P 0xcd {denied_offset} {SECTOR_SIZE}')

        with iotests.VM() as vm:
            vm.add_blockdev(f'file,node-name=base-file,read-only=on,'
                            f'filename={image}')
            vm.add_blockdev('partition-write-guard,node-name=guard-file,'
                            'file=base-file,partitions.0=1,partitions.1=3,'
                            'partitions.2=7')
            vm.add_blockdev('raw,node-name=guarded-base,file=guard-file')
            backing_node = 'guarded-base'
            for name, path in (('layer-a', layer_a),
                               ('layer-b', layer_b),
                               ('layer-c', layer_c)):
                vm.add_blockdev(vm.qmp_to_opts({
                    'driver': 'file', 'node-name': name + '-file',
                    'filename': path,
                }))
                vm.add_blockdev(vm.qmp_to_opts({
                    'driver': 'qcow2', 'node-name': name,
                    'file': name + '-file', 'backing': backing_node,
                }))
                backing_node = name
            vm.add_blockdev('partition-write-guard,node-name=active-guard,'
                            'file=layer-c,partitions.0=1,partitions.1=3,'
                            'partitions.2=7')
            vm.add_device('virtio-blk-pci,drive=active-guard,id=virtio0')
            vm.launch()
            vm.qmp('blockdev-reopen', options=[{
                'driver': 'file', 'node-name': 'base-file',
                'filename': image, 'read-only': False,
            }])
            job_id = 'commit-denied-layer'
            result = vm.qmp('block-commit', device='active-guard',
                            **{'job-id': job_id, 'base-node': 'guarded-base',
                               'top-node': 'layer-a', 'speed': 0,
                               'backing-file': image,
                               'backing-mask-protocol': True})
            self.assertIn('return', result, result)
            event = vm.event_wait(name='BLOCK_JOB_ERROR',
                                  match={'data': {'device': job_id}})
            self.assertIsNotNone(event)
            self.assertEqual(event['data']['action'], 'report')
            self.assertEqual(event['data']['operation'], 'write')
            vm.run_job(job_id, wait=60.0)
            vm.qmp('blockdev-reopen', options=[{
                'driver': 'file', 'node-name': 'base-file',
                'filename': image, 'read-only': True,
            }])

        with open(image, 'rb') as stream:
            stream.seek(denied_offset)
            self.assertEqual(stream.read(SECTOR_SIZE),
                             base_before[denied_offset:denied_offset + SECTOR_SIZE])
        for path in (layer_a, layer_b, layer_c):
            qemu_img('check', '-q', path)
        retained = qemu_io('-f', 'qcow2', layer_a, '-c',
                           f'read -P 0xcd {denied_offset} {SECTOR_SIZE}',
                           check=False)
        self.assertEqual(retained.returncode, 0, retained.stdout)

    def test_guarded_commit_rejects_off_allowlist_extent(self) -> None:
        overlay = self.test_img + '.qcow2'
        qemu_img('create', '-q', '-f', 'qcow2', '-F', 'raw',
                 '-o', 'cluster_size=512', '-b', self.test_img, overlay)
        denied_offset = PARTITIONS[2][0] * SECTOR_SIZE
        qemu_io('-f', 'qcow2', overlay, '-c',
                f'write -P 0xcd {denied_offset} {SECTOR_SIZE}')

        guarded_backing = ','.join([
            'driver=partition-write-guard',
            'file.driver=file',
